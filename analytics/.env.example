# Copy to .env (or your process manager / Docker environment).

# Required. Sets the admin password for the /analytics dashboard.
# If unset, the server generates a one-time random password and prints it to stdout.
ANALYTICS_ADMIN_PASSWORD=change-me

# Secret used to sign dashboard session cookies and hash visitor IPs.
# Set a long random value; keep it stable across restarts so logins survive restarts.
ANALYTICS_SESSION_SECRET=

# Port and bind address for the analytics server.
PORT=8787
# HOST=0.0.0.0

# Allowed origins for the tracking endpoint (CORS). "*" allows any site to send events.
# Set to your portfolio origin(s), comma-separated, if you want to restrict it.
# ANALYTICS_ALLOWED_ORIGINS=https://your-portfolio.com

# Set to 1 when running behind a reverse proxy that sets X-Forwarded-For.
# ANALYTICS_TRUST_PROXY=1

# Geolocation: "auto" (default, uses ipwho.is with caching) or "none" (offline, no lookups).
# ANALYTICS_GEO_MODE=auto

# How long to keep visitor data, in days. Older data is pruned on startup.
# ANALYTICS_RETENTION_DAYS=365

# Set to 1 to mark dashboard cookies as Secure (requires HTTPS).
# ANALYTICS_SECURE_COOKIE=1
