---
// Animated automation engineer — bottom-left background character.
// CHARACTER DESIGN: unchanged (cute male chibi engineer, DELL laptop back, etc.)
// FIX: .eng-upper-body wrapper groups torso + neck + head so look-around
//      moves the WHOLE upper body together — no floating head effect.
// ANIMATION LOGIC: JS look-around schedule unchanged (4–8s random interval).
---

<div class="eng-bg" aria-hidden="true">
  <svg
    class="eng-svg"
    viewBox="0 0 260 300"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
  >
    <defs>
      <radialGradient id="eg-skin" cx="0.45" cy="0.35" r="0.6">
        <stop offset="0"   stop-color="#f0b48a"/>
        <stop offset="1"   stop-color="#d4895e"/>
      </radialGradient>
      <linearGradient id="eg-shirt" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0"   stop-color="#2a3a6e"/>
        <stop offset="1"   stop-color="#1a2550"/>
      </linearGradient>
      <linearGradient id="eg-chair" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0"   stop-color="#1e2748"/>
        <stop offset="1"   stop-color="#141c38"/>
      </linearGradient>
      <linearGradient id="eg-laptop-cover" x1="0" y1="0" x2="0.3" y2="1">
        <stop offset="0"   stop-color="#22274a"/>
        <stop offset="1"   stop-color="#191e3a"/>
      </linearGradient>
      <linearGradient id="eg-desk" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0"   stop-color="#252e56"/>
        <stop offset="1"   stop-color="#1a2244"/>
      </linearGradient>
      <linearGradient id="eg-data-r" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0"   stop-color="#22d3ee" stop-opacity="0.6"/>
        <stop offset="0.6" stop-color="#22d3ee" stop-opacity="0.2"/>
        <stop offset="1"   stop-color="#22d3ee" stop-opacity="0"/>
      </linearGradient>
      <linearGradient id="eg-data-r2" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0"   stop-color="#a78bfa" stop-opacity="0.5"/>
        <stop offset="0.6" stop-color="#a78bfa" stop-opacity="0.15"/>
        <stop offset="1"   stop-color="#a78bfa" stop-opacity="0"/>
      </linearGradient>
    </defs>

    <!-- ambient rings -->
    <circle cx="130" cy="145" r="100" fill="none" stroke="#6366f1"
      stroke-width="0.7" stroke-dasharray="3 10" opacity="0.18">
      <animateTransform attributeName="transform" type="rotate"
        from="0 130 145" to="360 130 145" dur="70s" repeatCount="indefinite"/>
    </circle>
    <circle cx="130" cy="145" r="125" fill="none" stroke="#22d3ee"
      stroke-width="0.6" stroke-dasharray="2 12" opacity="0.11">
      <animateTransform attributeName="transform" type="rotate"
        from="360 130 145" to="0 130 145" dur="100s" repeatCount="indefinite"/>
    </circle>

    <!-- ── CHAIR (behind person, drawn first) ── -->
    <rect x="78"  y="248" width="104" height="14" rx="6"
      fill="url(#eg-chair)" stroke="#2a3560" stroke-width="1"/>
    <rect x="92"  y="172" width="76"  height="78" rx="10"
      fill="url(#eg-chair)" stroke="#2a3560" stroke-width="1"/>
    <rect x="100" y="178" width="60"  height="62" rx="6" fill="#151c38"/>
    <rect x="92"  y="168" width="76"  height="10" rx="5" fill="#2a3560"/>
    <rect x="72"  y="226" width="10" height="34" rx="4"
      fill="url(#eg-chair)" stroke="#2a3560" stroke-width="0.8"/>
    <rect x="178" y="226" width="10" height="34" rx="4"
      fill="url(#eg-chair)" stroke="#2a3560" stroke-width="0.8"/>
    <rect x="122" y="262" width="16" height="18" rx="3"
      fill="#1a2040" stroke="#2a3560" stroke-width="0.8"/>
    <line x1="130" y1="280" x2="100" y2="292" stroke="#2a3560" stroke-width="3.5" stroke-linecap="round"/>
    <line x1="130" y1="280" x2="160" y2="292" stroke="#2a3560" stroke-width="3.5" stroke-linecap="round"/>
    <line x1="130" y1="280" x2="130" y2="295" stroke="#2a3560" stroke-width="3.5" stroke-linecap="round"/>
    <circle cx="100" cy="293" r="3.5" fill="#1a2040" stroke="#2a3560" stroke-width="0.8"/>
    <circle cx="160" cy="293" r="3.5" fill="#1a2040" stroke="#2a3560" stroke-width="0.8"/>
    <circle cx="130" cy="296" r="3.5" fill="#1a2040" stroke="#2a3560" stroke-width="0.8"/>

    <!-- ── PERSON ── -->
    <g class="eng-person">

      <!-- legs (always visible below desk, not part of upper body) -->
      <path d="M108 248 C106 256 104 264 103 272"
        stroke="#1e2a54" stroke-width="11" stroke-linecap="round" fill="none"/>
      <path d="M152 248 C154 256 156 264 157 272"
        stroke="#1e2a54" stroke-width="11" stroke-linecap="round" fill="none"/>
      <ellipse cx="101" cy="274" rx="9"  ry="4.5" fill="#141830" stroke="#1a2040" stroke-width="0.8"/>
      <ellipse cx="159" cy="274" rx="9"  ry="4.5" fill="#141830" stroke="#1a2040" stroke-width="0.8"/>

      <!-- arms (drawn here so they appear behind the upper-body wrapper) -->
      <g class="eng-arm-l">
        <path d="M100 214 C96 226 97 238 104 248"
          fill="none" stroke="#1e2a54" stroke-width="12" stroke-linecap="round"/>
        <path d="M100 214 C97 222 97 230 100 238"
          fill="none" stroke="url(#eg-skin)" stroke-width="7" stroke-linecap="round"/>
        <circle class="eng-hand-l" cx="105" cy="246" r="6.5" fill="url(#eg-skin)"/>
      </g>
      <g class="eng-arm-r">
        <path d="M160 214 C164 226 163 238 156 248"
          fill="none" stroke="#1e2a54" stroke-width="12" stroke-linecap="round"/>
        <path d="M160 214 C163 222 163 230 160 238"
          fill="none" stroke="url(#eg-skin)" stroke-width="7" stroke-linecap="round"/>
        <circle class="eng-hand-r" cx="155" cy="246" r="6.5" fill="url(#eg-skin)"/>
      </g>

      <!-- ══════════════════════════════════════════════
           UPPER BODY WRAPPER — torso + neck + head move together.
           Transform-origin at shoulder level (130, 208) so the
           whole upper body pivots naturally upward from the seat.
           CSS .eng-upper-body handles idle breathing.
           CSS .eng-bg.is-looking .eng-upper-body handles look-around.
      ══════════════════════════════════════════════ -->
      <g class="eng-upper-body">

        <!-- torso (inside upper-body so it rises with head) -->
        <path d="M108 200 C100 203 94 210 92 220 C90 230 91 240 94 250
                 H166 C169 240 170 230 168 220 C166 210 160 203 152 200 Z"
          fill="url(#eg-shirt)"/>
        <!-- shirt collar V -->
        <path d="M122 200 L130 210 L138 200" fill="none"
          stroke="#364a88" stroke-width="1.4" stroke-linecap="round"/>
        <!-- ID badge -->
        <rect x="148" y="214" width="10" height="13" rx="2"
          fill="#1a2540" stroke="#38bdf8" stroke-width="0.8" opacity="0.8"/>
        <line x1="153" y1="214" x2="153" y2="212"
          stroke="#38bdf8" stroke-width="1" stroke-linecap="round"/>

        <!-- neck — connects torso to head, clearly visible when looking up -->
        <rect x="124" y="183" width="12" height="20" rx="5" fill="url(#eg-skin)"/>

        <!-- ── HEAD GROUP ── -->
        <g class="eng-head-group">
          <!-- hair -->
          <path d="M108 152 C106 132 114 118 130 116 C146 114 154 128 152 152
                    C150 142 147 136 142 134 C137 132 133 134 130 137
                    C128 134 124 132 119 134 C114 137 110 144 108 152 Z"
            fill="#1a1f3a"/>
          <rect x="106" y="148" width="5"  height="10" rx="2" fill="#1a1f3a"/>
          <rect x="149" y="148" width="5"  height="10" rx="2" fill="#1a1f3a"/>
          <!-- head shape -->
          <ellipse cx="130" cy="152" rx="24" ry="22" fill="url(#eg-skin)"/>
          <!-- ears -->
          <ellipse cx="106" cy="154" rx="5"   ry="6.5" fill="url(#eg-skin)"/>
          <ellipse cx="106" cy="154" rx="2.5" ry="4"   fill="#c8784e" opacity="0.4"/>
          <ellipse cx="154" cy="154" rx="5"   ry="6.5" fill="url(#eg-skin)"/>
          <ellipse cx="154" cy="154" rx="2.5" ry="4"   fill="#c8784e" opacity="0.4"/>
          <!-- eyebrows -->
          <path d="M119 144 Q123 141 127 143" fill="none" stroke="#2a1f14" stroke-width="1.5" stroke-linecap="round"/>
          <path d="M133 143 Q137 141 141 144" fill="none" stroke="#2a1f14" stroke-width="1.5" stroke-linecap="round"/>
          <!-- eyes -->
          <ellipse cx="123" cy="151" rx="5"   ry="5.5" fill="white"/>
          <ellipse cx="137" cy="151" rx="5"   ry="5.5" fill="white"/>
          <circle  cx="124" cy="152" r="3.5"  fill="#2a1a10"/>
          <circle  cx="138" cy="152" r="3.5"  fill="#2a1a10"/>
          <circle  cx="125.5" cy="150" r="1.2" fill="white" opacity="0.85"/>
          <circle  cx="139.5" cy="150" r="1.2" fill="white" opacity="0.85"/>
          <!-- nose -->
          <ellipse cx="130" cy="159" rx="2.5" ry="1.5" fill="#c8784e" opacity="0.4"/>
          <!-- smile -->
          <path d="M124 165 Q130 170 136 165"
            fill="none" stroke="#b06040" stroke-width="1.4" stroke-linecap="round"/>
          <!-- cheek blush -->
          <ellipse cx="116" cy="162" rx="5" ry="3" fill="#e0806a" opacity="0.22"/>
          <ellipse cx="144" cy="162" rx="5" ry="3" fill="#e0806a" opacity="0.22"/>
          <!-- glasses -->
          <rect x="114" y="147" width="13" height="10" rx="3"
            fill="rgba(103,232,249,0.06)" stroke="#67e8f9" stroke-width="1.1"/>
          <rect x="133" y="147" width="13" height="10" rx="3"
            fill="rgba(103,232,249,0.06)" stroke="#67e8f9" stroke-width="1.1"/>
          <line x1="127" y1="152" x2="133" y2="152" stroke="#67e8f9" stroke-width="1"/>
          <line x1="114" y1="152" x2="108" y2="152" stroke="#67e8f9" stroke-width="1"/>
          <line x1="146" y1="152" x2="152" y2="152" stroke="#67e8f9" stroke-width="1"/>
        </g><!-- end eng-head-group -->

      </g><!-- end eng-upper-body -->

    </g><!-- end eng-person -->

    <!-- ── DESK (drawn over arms/legs, under laptop) ── -->
    <rect x="60"  y="210" width="180" height="14" rx="5"
      fill="url(#eg-desk)" stroke="#2e3a6a" stroke-width="1"/>
    <line x1="64" y1="211" x2="236" y2="211"
      stroke="rgba(255,255,255,0.08)" stroke-width="1"/>
    <rect x="70"  y="224" width="8" height="28" rx="2" fill="#1a2244" stroke="#2a3260" stroke-width="0.8"/>
    <rect x="182" y="224" width="8" height="28" rx="2" fill="#1a2244" stroke="#2a3260" stroke-width="0.8"/>
    <rect x="66"  y="250" width="16" height="4" rx="2" fill="#141a30"/>
    <rect x="178" y="250" width="16" height="4" rx="2" fill="#141a30"/>

    <!-- ── LAPTOP BACK (drawn last — always on top, hides face) ── -->
    <polygon points="82,210  178,210  182,166  78,166"
      fill="url(#eg-laptop-cover)" stroke="#2e3a6a" stroke-width="1.2"/>
    <polygon points="82,210  178,210  182,166  78,166"
      fill="none" stroke="rgba(255,255,255,0.05)" stroke-width="1"/>
    <line x1="78"  y1="166" x2="182" y2="166"
      stroke="rgba(255,255,255,0.13)" stroke-width="1"/>
    <line x1="82"  y1="210" x2="178" y2="210"
      stroke="rgba(255,255,255,0.07)" stroke-width="1"/>
    <!-- DELL logo -->
    <ellipse cx="130" cy="188" rx="18" ry="12"
      fill="none" stroke="#b8c4dc" stroke-width="1.3" opacity="0.55"/>
    <text x="130" y="192" text-anchor="middle"
      font-family="Arial, Helvetica, sans-serif"
      font-size="9" font-weight="700" letter-spacing="2"
      fill="#b8c4dc" opacity="0.60">DELL</text>
    <circle class="eng-power-led" cx="172" cy="208" r="2" fill="#4ade80" opacity="0.8"/>
    <!-- hinge bar -->
    <polygon points="80,210  180,210  183,216  77,216"
      fill="#13192e" stroke="#2e3a6a" stroke-width="0.8"/>

    <!-- ── DATA CONNECTIONS ── -->
    <path d="M182 186 C 210 182, 238 178, 258 174"
      fill="none" stroke="url(#eg-data-r)" stroke-width="1.2" stroke-dasharray="3 6">
      <animate attributeName="stroke-dashoffset" values="0;-36" dur="1.8s" repeatCount="indefinite"/>
    </path>
    <path d="M182 196 C 208 194, 234 192, 258 190"
      fill="none" stroke="url(#eg-data-r2)" stroke-width="1" stroke-dasharray="3 7">
      <animate attributeName="stroke-dashoffset" values="0;-36" dur="2.4s" begin="-0.8s" repeatCount="indefinite"/>
    </path>
    <circle cx="220" cy="180" r="2" fill="#22d3ee" opacity="0.6">
      <animate attributeName="r"       values="2;3;2"          dur="1.8s" repeatCount="indefinite"/>
      <animate attributeName="opacity" values="0.35;0.75;0.35"  dur="1.8s" repeatCount="indefinite"/>
    </circle>
    <circle cx="244" cy="191" r="1.8" fill="#a78bfa" opacity="0.5">
      <animate attributeName="r"       values="1.8;2.8;1.8"    dur="2.5s" begin="-1s" repeatCount="indefinite"/>
      <animate attributeName="opacity" values="0.3;0.65;0.3"    dur="2.5s" begin="-1s" repeatCount="indefinite"/>
    </circle>
    <circle r="1.8" fill="#22d3ee">
      <animateMotion dur="2.2s" repeatCount="indefinite" rotate="auto">
        <mpath><path d="M184 186 C 210 182, 236 178, 256 174"/></mpath>
      </animateMotion>
      <animate attributeName="opacity" values="0.8;0.25;0.8" keyTimes="0;0.85;1" dur="2.2s" repeatCount="indefinite"/>
    </circle>
    <circle r="1.5" fill="#a78bfa">
      <animateMotion dur="2.8s" begin="-1.1s" repeatCount="indefinite" rotate="auto">
        <mpath><path d="M184 196 C 208 194, 232 192, 256 190"/></mpath>
      </animateMotion>
      <animate attributeName="opacity" values="0.7;0.2;0.7" keyTimes="0;0.85;1" dur="2.8s" begin="-1.1s" repeatCount="indefinite"/>
    </circle>

  </svg>
</div>

<style>
/* ── Positioning (unchanged) ── */
.eng-bg {
  position: fixed;
  bottom: 2vh;
  left: 2.5vw;
  width: clamp(120px, 12vw, 220px);
  aspect-ratio: 260 / 300;
  opacity: 0.88;
  pointer-events: none;
  filter: drop-shadow(0 12px 24px rgba(20, 30, 80, 0.22));
  z-index: 1;
}
.eng-svg {
  display: block;
  width: 100%;
  height: auto;
}

/* ── Typing: hands bob alternately (unchanged) ── */
.eng-hand-l {
  animation: eng-type-l 1.0s ease-in-out infinite alternate;
  transform-origin: 105px 244px;
}
.eng-hand-r {
  animation: eng-type-r 1.0s ease-in-out infinite alternate;
  animation-delay: -0.5s;
  transform-origin: 155px 244px;
}
@keyframes eng-type-l {
  from { transform: translateY(0px) rotate(-2deg); }
  to   { transform: translateY(3px) rotate(2deg);  }
}
@keyframes eng-type-r {
  from { transform: translateY(0px) rotate(2deg);  }
  to   { transform: translateY(3px) rotate(-2deg); }
}

/* ── Upper body: idle breathing ──
   Pivots from shoulder/hip origin (130, 210).
   Subtle scale + tiny forward lean to simulate breathing while seated. ── */
.eng-upper-body {
  animation: eng-breathe 6s ease-in-out infinite;
  transform-origin: 130px 210px;
}
@keyframes eng-breathe {
  0%,100% { transform: translateY(0px)   scaleY(1);      }
  45%      { transform: translateY(-1px)  scaleY(1.006);  }
}

/* ── Head idle bob (relative to upper body) ── */
.eng-head-group {
  animation: eng-head-idle 4s ease-in-out infinite;
  transform-origin: 130px 152px;
}
@keyframes eng-head-idle {
  0%,100% { transform: translateY(0px)    rotate(0deg);    }
  30%      { transform: translateY(-1px)   rotate(0.5deg);  }
  65%      { transform: translateY(-0.5px) rotate(-0.3deg); }
}

/* ── LOOK-AROUND: move entire upper body up, then head turns ──
   Upper body rises from shoulder pivot — lifts the torso, neck, and head
   together as a unit, so the neck becomes visible above the laptop top edge.
   The head then additionally rotates to look left/right.
   Laptop is drawn separately (on top) so it stays in place — the character
   "leans up" and their head emerges over the laptop. ── */

/* 1. Upper body rises — translates up from shoulder pivot */
.eng-bg.is-looking .eng-upper-body {
  animation: eng-body-rise 5.2s ease-in-out forwards;
  transform-origin: 130px 210px;
}
@keyframes eng-body-rise {
  0%   { transform: translateY(0px)   rotate(0deg); }
  8%   { transform: translateY(-6px)  rotate(-0.5deg); }
  18%  { transform: translateY(-14px) rotate(-1deg); }
  30%  { transform: translateY(-16px) rotate(1.5deg); }
  55%  { transform: translateY(-15px) rotate(-1deg); }
  75%  { transform: translateY(-10px) rotate(0.5deg); }
  90%  { transform: translateY(-4px)  rotate(-0.3deg); }
  100% { transform: translateY(0px)   rotate(0deg); }
}

/* 2. Head additionally rotates to look left/right (relative to risen body) */
.eng-bg.is-looking .eng-head-group {
  animation: eng-head-look 5.2s ease-in-out forwards;
  transform-origin: 130px 152px;
}
@keyframes eng-head-look {
  0%   { transform: translateY(0px)  rotate(0deg);  }
  10%  { transform: translateY(-4px) rotate(-4deg); }
  30%  { transform: translateY(-5px) rotate(5deg);  }
  55%  { transform: translateY(-5px) rotate(-6deg); }
  75%  { transform: translateY(-3px) rotate(3deg);  }
  90%  { transform: translateY(-1px) rotate(-1deg); }
  100% { transform: translateY(0px)  rotate(0deg);  }
}

/* Hands stop typing while looking */
.eng-bg.is-looking .eng-hand-l,
.eng-bg.is-looking .eng-hand-r {
  animation-play-state: paused;
}

/* ── Power LED pulse (unchanged) ── */
.eng-power-led {
  animation: eng-led 3s ease-in-out infinite;
}
@keyframes eng-led {
  0%,100% { opacity: 0.3; }
  50%      { opacity: 1.0; }
}

/* ── Mobile (unchanged) ── */
@media (max-width: 768px) {
  .eng-bg { width: 100px; bottom: 1vh; left: 1.5vw; opacity: 0.76; }
}
@media (max-width: 480px) {
  .eng-bg { width: 80px; opacity: 0.66; }
}

/* ── Reduced motion ── */
@media (prefers-reduced-motion: reduce) {
  .eng-svg *      { animation: none !important; }
  .eng-upper-body { transition: none; }
  .eng-head-group { transition: none; }
}
</style>

<script>
/* Look-around logic — schedule unchanged (4–8s random interval) */
(function () {
  const el = document.querySelector('.eng-bg');
  if (!el) return;
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

  const svg = el.querySelector('svg');

  document.addEventListener('visibilitychange', () => {
    if (document.hidden) { svg?.pauseAnimations(); }
    else { svg?.unpauseAnimations(); scheduleNext(); }
  });

  function randomInterval() {
    return (4 + Math.random() * 4) * 1000; // 4–8 seconds
  }

  let lookTimer = 0;

  function doLookAround() {
    if (document.hidden) return;
    el.classList.add('is-looking');
    setTimeout(() => {
      el.classList.remove('is-looking');
      scheduleNext();
    }, 5200); // matches animation duration
  }

  function scheduleNext() {
    clearTimeout(lookTimer);
    lookTimer = setTimeout(doLookAround, randomInterval());
  }

  scheduleNext();
})();
</script>
