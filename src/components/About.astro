---
import { ui } from '../i18n/ui';

const t = ui.en;
const font = "ui-monospace, SFMono-Regular, Cascadia Mono, Consolas, monospace";
---

<section id="about" class="py-20 sm:py-24" aria-labelledby="about-heading">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="glass spatial-card rounded-[2rem] p-6 sm:p-10 lg:p-14">
      <div class="grid gap-12 lg:grid-cols-5 lg:gap-16">
        <div class="lg:col-span-2">
          <p class="text-sm font-semibold uppercase tracking-widest text-indigo-500" data-i18n="about.kicker">{t.about.kicker}</p>
          <h2 id="about-heading" class="mt-2 text-3xl font-bold tracking-tight text-[#15152a] sm:text-4xl" data-i18n="about.title">
            {t.about.title}
          </h2>

          <!-- One compact industrial cell drawn in a fixed 460×300 viewBox:
               CONVEYOR (left, 125×45) → ROBOT pick & place (center, dominant,
               real 3-axis IK, base at x=230) → AGV (right, 85×25, flatter,
               smaller than the conveyor). Physical cell sits in a translate(0 40) so the
               floor renders at y=310, belt top at 265, AGV deck top at 275
               (viewBox 460×335). Control stack centered at x=230: CLOUD →
               MES → SCADA → PLC. Short curved guides carry thin cyan command
               and purple status particles — no static cables. -->
          <div class="about-factory" id="about-factory" aria-hidden="true">
            <svg
              viewBox="0 0 460 335"
              xmlns="http://www.w3.org/2000/svg"
              role="img"
              aria-label="Smart factory cell: a conveyor feeds boxes to a robot that places them on an AGV, supervised by PLC, SCADA, MES and cloud"
              focusable="false"
              font-family={font}
            >
              <defs>
                <filter id="ab-glow" x="-100%" y="-100%" width="300%" height="300%">
                  <feGaussianBlur stdDeviation="2" result="blur"/>
                  <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
                </filter>
              </defs>

              <!-- ════════════════════════════════════════════════════════
                   PHYSICAL CELL — exact fixed layout in viewBox space.
                   Conveyor x40→165, robot base center x=230 (IK pivot 230,260),
                    AGV x310→395. Floor line at y=270; belt top 225, AGV deck 235.
              ════════════════════════════════════════════════════════ -->
              <!-- physical cell nudged down 40px (floor renders at y=310) -->
              <g transform="translate(0 40)">
              <!-- one shared floor line for conveyor, robot and AGV -->
              <line x1="35" y1="270" x2="425" y2="270" stroke="rgba(30,42,85,0.22)" stroke-width="1" />

              <!-- ── CONVEYOR (LEFT) — 125×45: legs + feet, frame, belt,
                    rotating rollers, drive drum + stack light. Belt top at
                    y=225, the robot working plane. ── -->
              <g>
                <!-- legs to ground (thick, with feet) -->
                <line x1="52" y1="247" x2="52" y2="270" stroke="rgba(30,42,85,0.35)" stroke-width="4" />
                <line x1="150" y1="247" x2="150" y2="270" stroke="rgba(30,42,85,0.35)" stroke-width="4" />
                <line x1="44" y1="268" x2="60" y2="268" stroke="rgba(30,42,85,0.35)" stroke-width="3" />
                <line x1="142" y1="268" x2="158" y2="268" stroke="rgba(30,42,85,0.35)" stroke-width="3" />
                <!-- frame -->
                <rect x="40" y="237" width="125" height="10" rx="2" fill="rgba(30,42,85,0.12)" stroke="rgba(30,42,85,0.3)" stroke-width="1" />
                <!-- belt (top surface at y=225, the robot working plane) -->
                <rect x="38" y="225" width="129" height="12" rx="6" fill="rgba(148,163,184,0.45)" stroke="rgba(30,42,85,0.35)" stroke-width="1" />
                <!-- rollers (visible through the belt), rotating 1 rev/2s -->
                <g fill="rgba(30,42,85,0.55)" stroke="rgba(34,211,238,0.35)" stroke-width="1">
                  <g>
                    <animateTransform attributeName="transform" type="rotate" from="0 66 231" to="360 66 231" dur="2s" repeatCount="indefinite" />
                    <circle cx="66" cy="231" r="4" />
                    <line x1="66" y1="227" x2="66" y2="235" stroke="rgba(34,211,238,0.5)" stroke-width="1" />
                  </g>
                  <g>
                    <animateTransform attributeName="transform" type="rotate" from="0 92 231" to="360 92 231" dur="2s" repeatCount="indefinite" />
                    <circle cx="92" cy="231" r="4" />
                    <line x1="92" y1="227" x2="92" y2="235" stroke="rgba(34,211,238,0.5)" stroke-width="1" />
                  </g>
                  <g>
                    <animateTransform attributeName="transform" type="rotate" from="0 118 231" to="360 118 231" dur="2s" repeatCount="indefinite" />
                    <circle cx="118" cy="231" r="4" />
                    <line x1="118" y1="227" x2="118" y2="235" stroke="rgba(34,211,238,0.5)" stroke-width="1" />
                  </g>
                  <!-- roller under the box: slides out while the gripper lifts it -->
                  <g>
                    <animateTransform attributeName="transform" type="translate"
                      values="0 0;0 0;8 0;8 0;0 0;0 0"
                      keyTimes="0;0.26;0.36;0.50;0.58;1" dur="20s" repeatCount="indefinite" />
                    <g>
                      <animateTransform attributeName="transform" type="rotate" from="0 144 231" to="360 144 231" dur="2s" repeatCount="indefinite" />
                      <circle cx="144" cy="231" r="4" />
                      <line x1="144" y1="227" x2="144" y2="235" stroke="rgba(34,211,238,0.5)" stroke-width="1" />
                    </g>
                  </g>
                </g>
                <!-- drive drum at the left end (rotating, with spokes) -->
                <g>
                  <animateTransform attributeName="transform" type="rotate" from="0 48 231" to="360 48 231" dur="2s" repeatCount="indefinite" />
                  <circle cx="48" cy="231" r="8" fill="#1e2a55" stroke="rgba(34,211,238,0.4)" stroke-width="1" />
                  <line x1="40" y1="231" x2="56" y2="231" stroke="rgba(34,211,238,0.5)" stroke-width="1" />
                  <line x1="48" y1="223" x2="48" y2="239" stroke="rgba(34,211,238,0.5)" stroke-width="1" />
                </g>
                <!-- stack light mast + green/amber dots -->
                <line x1="48" y1="237" x2="48" y2="216" stroke="rgba(30,42,85,0.45)" stroke-width="2" />
                <circle cx="48" cy="212" r="2.5" fill="#10b981">
                  <animate attributeName="opacity" values="1;0.3;1" dur="1.4s" repeatCount="indefinite" />
                </circle>
                <circle cx="48" cy="205" r="2.5" fill="#f59e0b" />
                <!-- belt ticks (run while the belt feeds the box) -->
                <g>
                  <animateTransform attributeName="transform" type="translate"
                    values="0 0;0 0;40 0;40 0"
                    keyTimes="0;0.42;0.58;1" dur="20s" repeatCount="indefinite" />
                  <g stroke="rgba(34,211,238,0.6)" stroke-width="1.5">
                    <line x1="44" y1="227" x2="44" y2="233" />
                    <line x1="60" y1="227" x2="60" y2="233" />
                    <line x1="76" y1="227" x2="76" y2="233" />
                  </g>
                </g>
                <!-- belt direction hint -->
                <g stroke="rgba(34,211,238,0.45)" stroke-width="1.2" fill="none">
                  <line x1="64" y1="258" x2="102" y2="258" />
                  <polygon points="107,258 100,255 100,261" fill="rgba(34,211,238,0.45)" />
                </g>
              </g>

               <!-- ── AGV (RIGHT) — 85×25, flatter, clearly smaller than the conveyor.
                    Deck top at y=235, wheels centred on the floor line.
                   Drives right ~25px after receiving the box. ── -->
              <g>
                <animateTransform attributeName="transform" type="translate"
                  values="0 0;0 0;25 0;25 0;0 0;0 0"
                  keyTimes="0;0.62;0.74;0.86;0.98;1" dur="20s" repeatCount="indefinite" />
                <!-- ground shadow -->
                <ellipse cx="352" cy="268" rx="45" ry="2.5" fill="rgba(30,42,85,0.10)" />
                <!-- box riding on the deck (appears when the robot releases it) -->
                <g>
                  <animate attributeName="opacity" values="0;0;1;1;0;0"
                    keyTimes="0;0.58;0.62;0.94;0.98;1" dur="20s" repeatCount="indefinite" />
                  <rect x="314" y="223" width="12" height="12" rx="1" fill="rgba(30,58,95,0.9)" stroke="rgba(34,211,238,0.65)" stroke-width="1" />
                  <line x1="318" y1="226" x2="318" y2="231" stroke="rgba(34,211,238,0.5)" stroke-width="0.8" />
                  <line x1="322" y1="226" x2="322" y2="231" stroke="rgba(34,211,238,0.5)" stroke-width="0.8" />
                </g>
                <!-- running light -->
                <circle cx="333" cy="245" r="2" fill="#22d3ee">
                  <animate attributeName="opacity" values="1;0.25;1" dur="1.1s" repeatCount="indefinite" />
                </circle>
                <!-- body (deck top at 235) -->
                <rect x="310" y="235" width="85" height="25" rx="5" fill="rgba(30,58,95,0.9)" stroke="rgba(34,211,238,0.55)" stroke-width="1" />
                <line x1="314" y1="239" x2="391" y2="239" stroke="rgba(34,211,238,0.25)" stroke-width="1" />
                <!-- wheels on the floor line -->
                <circle cx="325" cy="270" r="6" fill="#1e2a55" stroke="rgba(34,211,238,0.4)" stroke-width="1" />
                <circle cx="325" cy="270" r="2" fill="rgba(255,255,255,0.5)" />
                <circle cx="380" cy="270" r="6" fill="#1e2a55" stroke="rgba(34,211,238,0.4)" stroke-width="1" />
                <circle cx="380" cy="270" r="2" fill="rgba(255,255,255,0.5)" />
              </g>

               <!-- ── INDUSTRIAL ROBOT (CENTER) — real 2-link IK, elbow-up.
                    Base pivot (230,260); L1=65, L2=60. PICK(145,213) sits on
                    the belt top (225), PLACE(320,223) on the AGV deck (235).
                    Wrist W = -(S+E) keeps the gripper and the gripped box
                    level. Arm never touches the floor. Controller cabinet
                    stands behind it, right of the pedestal. ── -->
              <g>
                <!-- controller cabinet (fixed structure) -->
                <rect x="252" y="240" width="18" height="30" rx="3" fill="rgba(30,58,95,0.92)" stroke="rgba(34,211,238,0.4)" stroke-width="1" />
                <line x1="256" y1="248" x2="266" y2="248" stroke="rgba(34,211,238,0.3)" stroke-width="1" />
                <line x1="256" y1="253" x2="266" y2="253" stroke="rgba(34,211,238,0.3)" stroke-width="1" />
                <line x1="256" y1="258" x2="266" y2="258" stroke="rgba(34,211,238,0.3)" stroke-width="1" />
                <circle cx="261" cy="245" r="1.5" fill="#10b981">
                  <animate attributeName="opacity" values="1;0.3;1" dur="1.2s" repeatCount="indefinite" />
                </circle>
                <!-- floor shadow + base plate + pedestal (chunky, dominant) -->
                <ellipse cx="230" cy="268" rx="32" ry="2.5" fill="rgba(30,42,85,0.12)" />
                <rect x="198" y="262" width="64" height="8" rx="3" fill="rgba(30,58,95,0.9)" stroke="rgba(34,211,238,0.4)" stroke-width="1" />
                <rect x="216" y="254" width="28" height="8" rx="2" fill="rgba(30,58,95,0.9)" stroke="rgba(34,211,238,0.4)" stroke-width="1" />
                <circle cx="230" cy="260" r="7" fill="rgba(255,255,255,0.75)" stroke="#06b6d4" stroke-width="1.4" />
                <circle cx="230" cy="260" r="2.5" fill="#1e2a55" />

                <!-- arm: HOME(15.6,-60.6,45.0) → PICK(-23.9,-78.1,102.0)
                     → LIFT(-22.6,-68.3,91.0) → PLACE_LIFT(27.7,67.5,-95.3)
                     → PLACE(30.6,77.8,-108.4) → PLACE_LIFT → HOME -->
                <g transform="translate(230 260)">
                  <g>
                    <animateTransform attributeName="transform" type="rotate"
                      values="15.6;-23.9;-22.6;-22.6;-22.6;27.7;30.6;27.7;15.6;15.6"
                      keyTimes="0;0.18;0.26;0.34;0.42;0.52;0.58;0.66;0.78;1"
                      keySplines="0.4 0 0.6 1;0.4 0 0.6 1;0.4 0 0.6 1;0.4 0 0.6 1;0.4 0 0.6 1;0.4 0 0.6 1;0.4 0 0.6 1;0.4 0 0.6 1;0.4 0 0.6 1"
                      calcMode="spline" dur="20s" repeatCount="indefinite" />
                    <line x1="0" y1="0" x2="0" y2="-65" stroke="#1e2a55" stroke-width="10" stroke-linecap="round" />
                    <line x1="0" y1="0" x2="0" y2="-65" stroke="rgba(255,255,255,0.35)" stroke-width="2.5" stroke-linecap="round" />
                    <circle cx="0" cy="-32" r="2" fill="#94a3b8" />
                    <circle cx="0" cy="-65" r="5.5" fill="rgba(51,65,85,0.95)" stroke="rgba(34,211,238,0.45)" stroke-width="1" />
                    <g transform="translate(0 -65)">
                      <g>
                        <animateTransform attributeName="transform" type="rotate"
                          values="-60.6;-78.1;-68.3;-68.3;-68.3;67.5;77.8;67.5;-60.6;-60.6"
                          keyTimes="0;0.18;0.26;0.34;0.42;0.52;0.58;0.66;0.78;1"
                          keySplines="0.4 0 0.6 1;0.4 0 0.6 1;0.4 0 0.6 1;0.4 0 0.6 1;0.4 0 0.6 1;0.4 0 0.6 1;0.4 0 0.6 1;0.4 0 0.6 1;0.4 0 0.6 1"
                          calcMode="spline" dur="20s" repeatCount="indefinite" />
                        <line x1="0" y1="0" x2="0" y2="-60" stroke="#1e2a55" stroke-width="8.5" stroke-linecap="round" />
                        <line x1="0" y1="0" x2="0" y2="-60" stroke="rgba(255,255,255,0.35)" stroke-width="2" stroke-linecap="round" />
                        <!-- wrist -->
                        <g transform="translate(0 -60)">
                          <g>
                            <animateTransform attributeName="transform" type="rotate"
                              values="45.0;102.0;91.0;91.0;91.0;-95.3;-108.4;-95.3;45.0;45.0"
                              keyTimes="0;0.18;0.26;0.34;0.42;0.52;0.58;0.66;0.78;1"
                              keySplines="0.4 0 0.6 1;0.4 0 0.6 1;0.4 0 0.6 1;0.4 0 0.6 1;0.4 0 0.6 1;0.4 0 0.6 1;0.4 0 0.6 1;0.4 0 0.6 1;0.4 0 0.6 1"
                              calcMode="spline" dur="20s" repeatCount="indefinite" />
                            <!-- gripped box: hangs level under the wrist -->
                            <g>
                              <animate attributeName="opacity" values="0;0;1;1;0;0"
                                keyTimes="0;0.28;0.32;0.56;0.60;1" dur="20s" repeatCount="indefinite" />
                              <rect x="-6" y="0" width="12" height="12" rx="1" fill="rgba(30,58,95,0.9)" stroke="rgba(34,211,238,0.65)" stroke-width="1" />
                              <line x1="-2" y1="3" x2="-2" y2="8" stroke="rgba(34,211,238,0.5)" stroke-width="0.8" />
                              <line x1="2"  y1="3" x2="2"  y2="8" stroke="rgba(34,211,238,0.5)" stroke-width="0.8" />
                            </g>
                            <!-- gripper -->
                            <circle cx="0" cy="0" r="3.5" fill="#ffffff" stroke="#06b6d4" stroke-width="1.3" />
                            <!-- open fingers -->
                            <path d="M0 0 L-8 6 M0 0 L8 6" stroke="#1e2a55" stroke-width="3.5" stroke-linecap="round" />
                            <!-- closed fingers (while gripping) -->
                            <g stroke="#1e2a55" stroke-width="4" stroke-linecap="round">
                              <animate attributeName="opacity" values="0;0;1;1;0;0"
                                keyTimes="0;0.28;0.32;0.56;0.60;1" dur="20s" repeatCount="indefinite" />
                              <path d="M-4 0 L-4 12 M4 0 L4 12" />
                            </g>
                          </g>
                        </g>
                      </g>
                    </g>
                  </g>
                </g>
              </g>

               <!-- BOXES ON THE CONVEYOR
                    Box A waits at the pick position (bottom = belt top 225);
                    Box B slides in from x=120 behind it and advances to the
                    pick once A has been lifted away. -->
               <!-- Box A (present at pick, gets picked this cycle) -->
               <g>
                 <animateTransform attributeName="transform" type="translate"
                   values="145 213;145 213" keyTimes="0;1" dur="20s" repeatCount="indefinite" />
                <g>
                  <animate attributeName="opacity" values="1;1;0;0;1"
                    keyTimes="0;0.28;0.32;0.98;1" dur="20s" repeatCount="indefinite" />
                  <rect x="-6" y="0" width="12" height="12" rx="1" fill="rgba(30,58,95,0.9)" stroke="rgba(34,211,238,0.65)" stroke-width="1" />
                  <line x1="-2" y1="3" x2="-2" y2="8" stroke="rgba(34,211,238,0.5)" stroke-width="0.8" />
                  <line x1="2"  y1="3" x2="2"  y2="8" stroke="rgba(34,211,238,0.5)" stroke-width="0.8" />
                </g>
              </g>
              <!-- Box B (slides in, stops behind A, advances after pickup) -->
              <g>
                <animateTransform attributeName="transform" type="translate"
                   values="120 213;120 213;145 213;145 213"
                   keyTimes="0;0.44;0.56;1" dur="20s" repeatCount="indefinite" />
                <g>
                  <animate attributeName="opacity" values="0;0;1;1"
                    keyTimes="0;0.44;0.48;1" dur="20s" repeatCount="indefinite" />
                  <rect x="-6" y="0" width="12" height="12" rx="1" fill="rgba(30,58,95,0.9)" stroke="rgba(34,211,238,0.65)" stroke-width="1" />
                  <line x1="-2" y1="3" x2="-2" y2="8" stroke="rgba(34,211,238,0.5)" stroke-width="0.8" />
                  <line x1="2"  y1="3" x2="2"  y2="8" stroke="rgba(34,211,238,0.5)" stroke-width="0.8" />
                </g>
              </g>

              <!-- device terminal pads -->
              <g fill="rgba(34,211,238,0.5)">
                <circle cx="104" cy="242" r="2" />
                <circle cx="262" cy="222" r="2" />
                <circle cx="348" cy="245" r="2" />
              </g>

              <!-- device labels (tiny) -->
              <g fill="rgba(100,116,139,0.75)" font-size="8" letter-spacing="1" text-anchor="middle">
                <text x="102" y="285">CONVEYOR</text>
                <text x="230" y="285">ROBOT</text>
                <text x="352" y="285">AGV</text>
              </g>
              </g>

              <!-- ════════════════════════════════════════════════════════
                   CONTROL STACK — CLOUD → MES → SCADA → PLC, centered at
                   x=230 (icons span x≈190→270). PLC is the strongest.
              ════════════════════════════════════════════════════════ -->
              <!-- stack connector guides (thin, short) -->
              <g stroke="rgba(30,42,85,0.20)" stroke-width="1">
                <line x1="230" y1="45" x2="230" y2="58" />
                <line x1="230" y1="82" x2="230" y2="95" />
                <line x1="230" y1="115" x2="230" y2="127" />
              </g>

              <!-- CLOUD (45×22, center 230,35) -->
              <g transform="translate(230 35)" stroke="#06b6d4" stroke-width="1.6" fill="none" opacity="0.85">
                <ellipse cx="-12" cy="5" rx="13" ry="7" />
                <ellipse cx="0" cy="-4" rx="14" ry="10" />
                <ellipse cx="10" cy="4" rx="10" ry="6" />
              </g>
              <!-- MES (chip, 30×25, center 230,70) -->
              <g transform="translate(230 70)" stroke="#06b6d4" stroke-width="1.5" opacity="0.9">
                <rect x="-15" y="-12" width="30" height="24" rx="4" fill="rgba(30,58,95,0.5)" />
                <line x1="-15" y1="-7" x2="-21" y2="-7" />
                <line x1="-15" y1="0"  x2="-21" y2="0" />
                <line x1="-15" y1="7"  x2="-21" y2="7" />
                <line x1="15"  y1="-7" x2="21" y2="-7" />
                <line x1="15"  y1="0"  x2="21"  y2="0" />
                <line x1="15"  y1="7"  x2="21"  y2="7" />
              </g>
              <!-- SCADA (monitor, 32×25, center 230,105) -->
              <g transform="translate(230 105)" stroke="#06b6d4" stroke-width="1.5" fill="none" opacity="0.9">
                <rect x="-16" y="-10" width="32" height="20" rx="2" />
                <rect x="-12" y="-6" width="24" height="12" rx="1" fill="rgba(34,211,238,0.13)" />
                <line x1="0" y1="10" x2="0" y2="14" />
                <line x1="-5" y1="14" x2="5" y2="14" />
              </g>
              <!-- PLC (DIN block, strongest/largest, 42×25, center 230,140) -->
              <g>
                <rect x="209" y="127.5" width="42" height="25" rx="4" fill="rgba(30,58,95,0.95)" stroke="rgba(34,211,238,0.75)" stroke-width="1.6" />
                <circle cx="216" cy="134" r="2.5" fill="#10b981" />
                <circle cx="230" cy="134" r="2.5" fill="#22d3ee">
                  <animate attributeName="opacity" values="1;0.2;1" dur="0.8s" repeatCount="indefinite" />
                </circle>
                <circle cx="244" cy="134" r="2.5" fill="#94a3b8" />
                <circle cx="219" cy="149" r="1.5" fill="rgba(34,211,238,0.85)" />
                <circle cx="230" cy="149" r="1.5" fill="rgba(34,211,238,0.85)" />
                <circle cx="241" cy="149" r="1.5" fill="rgba(34,211,238,0.85)" />
              </g>

              <!-- stack labels (tiny, right of each icon) -->
              <g fill="#64748b" font-size="8" letter-spacing="0.5">
                <text x="255" y="39">CLOUD</text>
                <text x="255" y="74">MES</text>
                <text x="255" y="109">SCADA</text>
                <text x="255" y="144">PLC</text>
              </g>

              <!-- ════════════════════════════════════════════════════════
                   PLC → DEVICE SIGNAL GUIDES — short, thin. The moving
                   cyan/purple particles below are the actual signals.
              ════════════════════════════════════════════════════════ -->
              <g stroke="rgba(30,42,85,0.20)" stroke-width="1" fill="none">
                <path d="M230 153 C 195 200, 140 225, 104 282" />   <!-- PLC → conveyor -->
                <path d="M230 153 C 245 210, 255 235, 262 259" />   <!-- PLC → robot -->
                <path d="M230 153 C 270 205, 318 225, 348 285" />   <!-- PLC → AGV -->
              </g>

              <!-- ════════════════════════════════════════════════════════
                   DATA SIGNAL FLOWS (continuous, two-way)
                   Cyan = commands flowing down (CLOUD→MES→SCADA→PLC→devices).
                   Purple = status flowing up (devices→PLC→SCADA→MES→CLOUD).
