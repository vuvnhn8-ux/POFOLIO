---
import { ui } from '../i18n/ui';

const t = ui.en;
---

<section id="about" class="border-t border-slate-800/60 py-20 sm:py-24" aria-labelledby="about-heading">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="grid gap-12 lg:grid-cols-5 lg:gap-16">
      <div class="lg:col-span-2">
        <p class="text-sm font-semibold uppercase tracking-widest text-emerald-400" data-i18n="about.kicker">{t.about.kicker}</p>
        <h2 id="about-heading" class="mt-2 text-3xl font-bold tracking-tight text-white sm:text-4xl" data-i18n="about.title">
          {t.about.title}
        </h2>
      </div>

      <div class="space-y-5 text-base leading-relaxed text-slate-400 lg:col-span-3 sm:text-lg">
        <p data-i18n="about.p1">{t.about.p1}</p>
        <p data-i18n="about.p2">{t.about.p2}</p>
        <p data-i18n="about.p3">{t.about.p3}</p>

        <ul class="mt-8 grid gap-3 sm:grid-cols-2" id="about-bullets">
          {
            t.about.bullets.map((item, i) => (
              <li class="flex items-start gap-2.5 text-sm text-slate-300">
                <svg
                  class="mt-0.5 h-5 w-5 shrink-0 text-emerald-400"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                  aria-hidden="true"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
                <span data-i18n={`about.bullets.${i}`}>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
