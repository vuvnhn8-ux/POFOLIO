<style>
/* One small physical automation cell — floats in the empty lower-left of the
   About card. No card, no panel, no dashboard: a clean miniature smart
   factory. Hidden below lg so the single-column mobile/tablet layout stays
   clean (the empty left column only exists at lg and up). */
.about-factory {
  margin-top: 2.5rem;
}

.about-factory svg {
  display: block;
  width: 100%;
  height: auto;
}

@media (max-width: 1023.98px) {
  .about-factory { display: none; }
}
</style>

<script>
// Pause the SMIL animation for users who prefer reduced motion —
// the first frame (box waiting at pick, robot at home) stays visible.
if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
  document.getElementById('about-factory')?.querySelectorAll('svg').forEach((svg) => svg.pauseAnimations());
}
</script>
