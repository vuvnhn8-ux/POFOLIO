---
import { ui } from '../i18n/ui';

const t = ui.en;
---

<section id="vibe" class="py-20 sm:py-24" aria-labelledby="vibe-heading">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl">
      <p class="text-sm font-semibold uppercase tracking-widest text-emerald-500" data-i18n="vibe.kicker">{t.vibe.kicker}</p>
      <h2 id="vibe-heading" class="mt-2 text-3xl font-bold tracking-tight text-[#15152a] sm:text-4xl" data-i18n="vibe.title">
        {t.vibe.title}
      </h2>
      <p class="mt-4 text-base text-slate-500 sm:text-lg" data-i18n="vibe.subtitle">
        {t.vibe.subtitle}
      </p>
    </div>

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        t.vibe.items.map((item, i) => (
          <article class="glass spatial-card group flex flex-col overflow-hidden rounded-[1.75rem] p-6">
            <div class="flex items-start justify-between gap-3">
              <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-gradient-to-br from-emerald-400 to-teal-500 font-bold text-white shadow-lg shadow-emerald-500/20">
                {String(i + 1).padStart(2, '0')}
              </div>
              <span class="rounded-full border border-emerald-200/60 bg-emerald-50/70 px-2.5 py-1 text-[10px] font-semibold uppercase tracking-wider text-emerald-600" data-i18n={`vibe.items.${i}.category`}>
                {item.category}
              </span>
            </div>

            <h3 class="mt-5 text-xl font-bold text-[#15152a]" data-i18n={`vibe.items.${i}.name`}>{item.name}</h3>
            <p class="mt-1.5 flex-1 text-sm leading-relaxed text-slate-500" data-i18n={`vibe.items.${i}.desc`}>{item.desc}</p>

            <ul class="mt-4 flex flex-wrap gap-2" aria-label="Technologies">
              {item.tech.map((tag, j) => (
                <li class="rounded-lg border border-white/70 bg-white/50 px-2.5 py-1 font-mono text-[11px] text-slate-600" data-i18n={`vibe.items.${i}.tech.${j}`}>
                  {tag}
                </li>
              ))}
            </ul>

            <div class="mt-5 flex items-center justify-between border-t border-white/60 pt-5">
              <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-50 px-2.5 py-1 text-[10px] font-semibold text-emerald-600">
                <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
                <span data-i18n="vibe.aiAssisted">{t.vibe.aiAssisted}</span>
              </span>
              <a
                href={item.url}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 rounded-xl bg-[#1a1a2e] px-3.5 py-2 text-xs font-semibold text-white shadow-lg shadow-indigo-950/20 transition hover:bg-[#2a2a45]"
              >
                <span data-i18n="vibe.visit">{t.vibe.visit}</span>
                <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7m0 0H8m9 0v9" />
                </svg>
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
