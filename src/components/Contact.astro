---
import { profile } from '../i18n/ui';

const socials = [
  {
    href: profile.linkedInUrl,
    label: 'LinkedIn',
    icon: 'linkedin',
    color: '#0a66c2',
    glow: 'rgba(10,102,194,0.25)',
  },
  {
    href: profile.facebookUrl,
    label: 'Facebook',
    icon: 'facebook',
    color: '#1877f2',
    glow: 'rgba(24,119,242,0.25)',
  },
  {
    href: profile.instagramUrl,
    label: 'Instagram',
    icon: 'instagram',
    color: '#e1306c',
    glow: 'rgba(225,48,108,0.25)',
  },
  {
    href: profile.whatsappUrl,
    label: 'WhatsApp',
    icon: 'whatsapp',
    color: '#25d366',
    glow: 'rgba(37,211,102,0.25)',
  },
] as const;
---

<section id="contact" class="py-24 sm:py-32" aria-label="Contact">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="glass-deep mx-auto flex max-w-sm flex-col items-center gap-8 rounded-[2.5rem] px-10 py-12 text-center">

      <!-- ── Large mail icon button (no email text) ── -->
      <a
        href={`mailto:${profile.email}`}
        class="contact-mail-btn"
        aria-label="Send email"
        title="Send email"
      >
        <svg
          class="contact-mail-icon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <rect x="2" y="4" width="20" height="16" rx="3" />
          <path d="M2 7l10 7 10-7" />
        </svg>
      </a>

      <!-- ── Four social icon buttons ── -->
      <div class="flex items-center gap-4" aria-label="Social profiles">
        {socials.map((s) => (
          <a
            href={s.href}
            target="_blank"
            rel="noopener noreferrer"
            class="contact-social-btn"
            aria-label={s.label}
            title={s.label}
            style={`--s-color:${s.color};--s-glow:${s.glow};`}
          >
            {s.icon === 'linkedin' && (
              <svg class="contact-social-icon" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
              </svg>
            )}
            {s.icon === 'facebook' && (
              <svg class="contact-social-icon" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M24 12.073C24 5.405 18.627 0 12 0S0 5.405 0 12.073C0 18.1 4.388 23.094 10.125 24v-8.437H7.078v-3.49h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.49h-2.796V24C19.612 23.094 24 18.1 24 12.073z" />
              </svg>
            )}
            {s.icon === 'instagram' && (
              <svg class="contact-social-icon" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z" />
              </svg>
            )}
            {s.icon === 'whatsapp' && (
              <svg class="contact-social-icon" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.435 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
              </svg>
            )}
          </a>
        ))}
      </div>

    </div>
  </div>
</section>

<style>
  /* ── Mail button — larger primary icon ── */
  .contact-mail-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 80px;
    height: 80px;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.65);
    border: 1px solid rgba(255, 255, 255, 0.80);
    color: #6366f1;
    /* floating glass depth */
    box-shadow:
      0 1px 0   rgba(255,255,255,0.9) inset,
      0 4px 16px rgba(99,102,241,0.18),
      0 8px 32px rgba(99,102,241,0.12),
      0 2px  8px rgba(30,27,75,0.08);
    transition:
      transform 0.30s cubic-bezier(0.22,1,0.36,1),
      box-shadow 0.30s cubic-bezier(0.22,1,0.36,1),
      background-color 0.25s ease;
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }
  .contact-mail-btn:hover {
    transform: translateY(-4px) scale(1.06);
    background: rgba(255,255,255,0.85);
    box-shadow:
      0 1px 0   rgba(255,255,255,0.95) inset,
      0 6px 24px rgba(99,102,241,0.28),
      0 12px 40px rgba(99,102,241,0.16),
      0 3px 12px rgba(30,27,75,0.10);
  }
  .contact-mail-btn:active {
    transform: translateY(-1px) scale(0.98);
  }
  .contact-mail-icon {
    width: 36px;
    height: 36px;
  }

  /* ── Social buttons ── */
  .contact-social-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.58);
    border: 1px solid rgba(255, 255, 255, 0.75);
    color: var(--s-color, #64748b);
    /* floating glass depth — subtle per-icon glow */
    box-shadow:
      0 1px 0   rgba(255,255,255,0.88) inset,
      0 3px 10px var(--s-glow, rgba(0,0,0,0.10)),
      0 6px 20px rgba(30,27,75,0.08),
      0 2px  6px rgba(30,27,75,0.06);
    transition:
      transform 0.28s cubic-bezier(0.22,1,0.36,1),
      box-shadow 0.28s cubic-bezier(0.22,1,0.36,1),
      background-color 0.22s ease;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
  .contact-social-btn:hover {
    transform: translateY(-3px) scale(1.08);
    background: rgba(255,255,255,0.82);
    box-shadow:
      0 1px 0   rgba(255,255,255,0.95) inset,
      0 4px 16px var(--s-glow, rgba(0,0,0,0.15)),
      0 10px 30px rgba(30,27,75,0.12),
      0 3px  8px rgba(30,27,75,0.08);
  }
  .contact-social-btn:active {
    transform: translateY(0) scale(0.96);
  }
  .contact-social-icon {
    width: 22px;
    height: 22px;
  }
</style>
