---
import { ui } from '../i18n/ui';
import RealtimeSCADA from './digitaltwin/RealtimeSCADA.astro';
import ClosedLoopControl from './digitaltwin/ClosedLoopControl.astro';
import RobotPickPlace from './digitaltwin/RobotPickPlace.astro';
import FactoryDataFlow from './digitaltwin/FactoryDataFlow.astro';

const t = ui.en;
// Item order is fixed across locales: 0 = SCADA, 1 = AI+PLC Loop, 2 = Robot Cell, 3 = Plant Stack.
const visuals = [RealtimeSCADA, ClosedLoopControl, RobotPickPlace, FactoryDataFlow];
---

<section id="systems" class="py-20 sm:py-24" aria-labelledby="systems-heading">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl">
      <p class="text-sm font-semibold uppercase tracking-widest text-indigo-500" data-i18n="systems.kicker">{t.systems.kicker}</p>
      <h2 id="systems-heading" class="mt-2 text-3xl font-bold tracking-tight text-[#15152a] sm:text-4xl" data-i18n="systems.title">
        {t.systems.title}
      </h2>
      <p class="mt-4 text-base text-slate-500 sm:text-lg" data-i18n="systems.subtitle">
        {t.systems.subtitle}
      </p>
    </div>

    <div class="mt-12 grid gap-6 sm:grid-cols-2">
      {
        t.systems.items.map((item, i) => (
          <figure class="glass spatial-card group overflow-hidden rounded-[1.75rem] p-3">
            <div class="twin overflow-hidden rounded-2xl">
              {
                (() => {
                  const Visual = visuals[i];
                  return <Visual />;
                })()
              }
            </div>
            <figcaption class="px-3 pb-3 pt-5">
              <h3 class="text-base font-bold text-[#15152a]" data-i18n={`systems.items.${i}.title`}>{item.title}</h3>
              <p class="mt-1.5 text-sm leading-relaxed text-slate-500" data-i18n={`systems.items.${i}.desc`}>{item.desc}</p>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>
