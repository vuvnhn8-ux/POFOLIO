---
import { profile, ui } from '../i18n/ui';

const year = new Date().getFullYear();
const t = ui.en;
---

<footer class="border-t border-slate-800/80 bg-slate-950">
  <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-4 px-4 py-8 sm:flex-row sm:px-6 lg:px-8">
    <p class="text-sm text-slate-500">
      © {year} {profile.brandName}. <span data-i18n="footer.tagline">{t.footer.tagline}</span>
    </p>
    <nav aria-label="Footer">
      <ul class="flex flex-wrap items-center justify-center gap-4 text-sm text-slate-500">
        <li><a href="#about" class="transition hover:text-slate-300" data-i18n="footer.about">{t.footer.about}</a></li>
        <li><a href="#systems" class="transition hover:text-slate-300" data-i18n="nav.systems">{t.nav.systems}</a></li>
        <li><a href="#case-studies" class="transition hover:text-slate-300" data-i18n="footer.caseStudies">{t.footer.caseStudies}</a></li>
        <li><a href="#beyond" class="transition hover:text-slate-300" data-i18n="nav.beyond">{t.nav.beyond}</a></li>
        <li><a href="#contact" class="transition hover:text-slate-300" data-i18n="footer.contact">{t.footer.contact}</a></li>
      </ul>
    </nav>
  </div>
</footer>
