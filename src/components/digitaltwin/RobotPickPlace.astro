  <!-- turntable -->
  <ellipse cx="215" cy="232" rx="11" ry="3.5" fill="#0d1530" stroke="#2a4a7a" stroke-width="1.2"/>
  <!-- shoulder joint disc -->
  <circle cx="215" cy="232" r="7" fill="#0c1428" stroke="#38bdf8" stroke-width="2" filter="url(#rpp-glow-sm)"/>
  <circle cx="215" cy="232" r="3" fill="#38bdf8" opacity="0.6"/>

  <!-- ════════════════════════════════════════
       ARM HIERARCHY (JS-driven)
       #rpp-j1: translate(215,232) rotate(θ1)
         arm1 drawn (0,0)→(0,-80)
         #rpp-j2: translate(0,-80) rotate(θ2)
           arm2 drawn (0,0)→(0,-65)
