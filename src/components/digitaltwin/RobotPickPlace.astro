  <line x1="72"  y1="255" x2="72"  y2="272" stroke="#253360" stroke-width="3" stroke-linecap="round"/>
  <line x1="132" y1="255" x2="132" y2="272" stroke="#253360" stroke-width="3" stroke-linecap="round"/>
  <text x="73" y="236" fill="#475569" font-size="9" letter-spacing="1">PICK</text>
  <line x1="96" y1="236" x2="108" y2="236" stroke="#22d3ee" stroke-width="1" opacity="0.5"/>
  <line x1="102" y1="230" x2="102" y2="242" stroke="#22d3ee" stroke-width="1" opacity="0.5"/>

  <!-- RIGHT PLACE TABLE — surface at y=242 -->
  <rect x="288" y="242" width="88" height="13" rx="3" fill="#111828" stroke="#253360" stroke-width="1"/>
  <line x1="302" y1="255" x2="302" y2="272" stroke="#253360" stroke-width="3" stroke-linecap="round"/>
  <line x1="362" y1="255" x2="362" y2="272" stroke="#253360" stroke-width="3" stroke-linecap="round"/>
  <text x="303" y="236" fill="#475569" font-size="9" letter-spacing="1">PLACE</text>
  <line x1="326" y1="236" x2="338" y2="236" stroke="#22d3ee" stroke-width="1" opacity="0.5"/>
  <line x1="332" y1="230" x2="332" y2="242" stroke="#22d3ee" stroke-width="1" opacity="0.5"/>

  <!-- WORKPIECE on LEFT (hidden after pickup) -->
  <rect id="rpp-part-left" x="95" y="228" width="14" height="14" rx="2"
    fill="#fbbf24" stroke="#f59e0b" stroke-width="1"/>
  <!-- WORKPIECE on RIGHT (shown after release) -->
  <rect id="rpp-part-right" x="325" y="228" width="14" height="14" rx="2"
    fill="#fbbf24" stroke="#f59e0b" stroke-width="1" opacity="0"/>

  <!-- Transfer arc hint -->
  <g clip-path="url(#rpp-cell-clip)">
    <path d="M102 228 C 130 140, 295 140, 332 228"
      fill="none" stroke="#22d3ee" stroke-width="1" stroke-dasharray="2 9" opacity="0.13">
      <animate attributeName="stroke-dashoffset" values="0;-44" dur="1.8s" repeatCount="indefinite"/>
    </path>
  </g>

  <!-- ════════════════════════════════════════
       ROBOT BASE — fixed at (215, 242)
       Column, turntable, J1 shoulder disc
  ════════════════════════════════════════ -->
  <!-- floor plate -->
  <ellipse cx="215" cy="254" rx="32" ry="7" fill="#22d3ee" opacity="0.05">
    <animate attributeName="opacity" values="0.03;0.09;0.03" dur="2.2s" repeatCount="indefinite"/>
  </ellipse>
  <rect x="199" y="250" width="32" height="8"  rx="3" fill="#0f1830" stroke="#1e3060" stroke-width="1.2"/>
  <!-- column -->
  <rect x="208" y="232" width="14" height="20" rx="4" fill="#121c3a" stroke="#1e3060" stroke-width="1.2"/>
  <!-- turntable -->
  <ellipse cx="215" cy="232" rx="11" ry="3.5" fill="#0d1530" stroke="#2a4a7a" stroke-width="1.2"/>
  <!-- shoulder joint disc -->
  <circle cx="215" cy="232" r="7" fill="#0c1428" stroke="#38bdf8" stroke-width="2" filter="url(#rpp-glow-sm)"/>
  <circle cx="215" cy="232" r="3" fill="#38bdf8" opacity="0.6"/>

  <!-- ════════════════════════════════════════
       ARM HIERARCHY (JS-driven)
       #rpp-j1: translate(215,232) rotate(θ1)
         arm1 drawn (0,0)→(0,-80)
         #rpp-j2: translate(0,-80) rotate(θ2)
           arm2 drawn (0,0)→(0,-65)
           #rpp-ee: translate(0,-65) [gripper]
  ════════════════════════════════════════ -->

  <g id="rpp-j1">
    <!-- ARM 1: glow halo + main link -->
    <line x1="0" y1="0" x2="0" y2="-80" stroke="#22d3ee" stroke-width="11" stroke-linecap="round" opacity="0.10"/>
    <line x1="0" y1="0" x2="0" y2="-80" stroke="#22d3ee" stroke-width="6"  stroke-linecap="round"/>
    <!-- highlight stripe -->
    <line x1="0" y1="-5" x2="0" y2="-75" stroke="#7dd3fc" stroke-width="1.5" stroke-linecap="round" opacity="0.30"/>
    <!-- elbow joint at (0,-80) -->
    <circle cx="0" cy="-80" r="7"   fill="#0c1428" stroke="#38bdf8" stroke-width="1.8" filter="url(#rpp-glow-sm)"/>
    <circle cx="0" cy="-80" r="2.8" fill="#38bdf8" opacity="0.55"/>

    <g id="rpp-j2">
      <!-- ARM 2 -->
      <line x1="0" y1="0" x2="0" y2="-65" stroke="#67e8f9" stroke-width="9"  stroke-linecap="round" opacity="0.10"/>
      <line x1="0" y1="0" x2="0" y2="-65" stroke="#67e8f9" stroke-width="5"  stroke-linecap="round"/>
      <line x1="0" y1="-5" x2="0" y2="-60" stroke="#a5f3fc" stroke-width="1.2" stroke-linecap="round" opacity="0.28"/>
      <!-- wrist joint at (0,-65) -->
      <circle cx="0" cy="-65" r="6"   fill="#0c1428" stroke="#a5f3fc" stroke-width="1.6" filter="url(#rpp-glow-sm)"/>
      <circle cx="0" cy="-65" r="2.4" fill="#a5f3fc" opacity="0.50"/>

      <!-- END EFFECTOR at (0,-65) -->
      <g id="rpp-ee" transform="translate(0,-65)">
        <!-- tool shaft -->
        <line x1="0" y1="0" x2="0" y2="-14" stroke="#c4b5fd" stroke-width="4" stroke-linecap="round" opacity="0.9"/>
        <!-- flange -->
        <circle cx="0" cy="-14" r="5"   fill="#0c1428" stroke="#c4b5fd" stroke-width="1.5"/>
        <circle cx="0" cy="-14" r="2"   fill="#c4b5fd" opacity="0.55"/>

        <!-- GRIPPER OPEN -->
        <g id="rpp-grip-open">
          <line x1="0" y1="-14" x2="-10" y2="-24" stroke="#67e8f9" stroke-width="3.2" stroke-linecap="round"/>
          <line x1="0" y1="-14" x2=" 10" y2="-24" stroke="#67e8f9" stroke-width="3.2" stroke-linecap="round"/>
          <line x1="-13" y1="-24" x2="-7"  y2="-24" stroke="#67e8f9" stroke-width="2.5" stroke-linecap="round"/>
          <line x1="  7" y1="-24" x2=" 13" y2="-24" stroke="#67e8f9" stroke-width="2.5" stroke-linecap="round"/>
        </g>

        <!-- GRIPPER CLOSED -->
        <g id="rpp-grip-closed" style="display:none">
          <line x1="-4" y1="-14" x2="-4" y2="-28" stroke="#22d3ee" stroke-width="3.5" stroke-linecap="round"/>
          <line x1=" 4" y1="-14" x2=" 4" y2="-28" stroke="#22d3ee" stroke-width="3.5" stroke-linecap="round"/>
          <line x1="-4" y1="-28" x2=" 4" y2="-28" stroke="#22d3ee" stroke-width="2.5" stroke-linecap="round"/>
        </g>

        <!-- HELD WORKPIECE -->
        <rect id="rpp-held" x="-7" y="-46" width="14" height="14" rx="2"
          fill="#fbbf24" stroke="#f59e0b" stroke-width="1.2" style="display:none"/>
      </g>
    </g>
  </g>

  <!-- PLC PANEL -->
  <rect x="440" y="52" width="186" height="278" rx="10" fill="#0b1228" stroke="#1a2a50" stroke-width="1"/>
  <text x="454" y="74" fill="#7dd3fc" font-size="11" font-weight="700" letter-spacing="1">PLC CONTROLLER</text>
  <text x="454" y="87" fill="#64748b" font-size="9">3-AXIS &middot; POSE CONTROL &middot; YRC-1000</text>

  <rect x="452" y="96" width="162" height="110" rx="6" fill="#060c1c" stroke="#162040" stroke-width="1"/>
  <text x="462" y="112" fill="#64748b" font-size="8" letter-spacing="1">JOINT ANGLES</text>
  <g fill="#94a3b8" font-size="9">
    <text x="462" y="128">J1  (SHOULDER)</text>
    <text x="462" y="144">J2  (ELBOW)</text>
    <text x="462" y="160">ELBOW HT</text>
    <text x="462" y="176">GRIPPER</text>
    <text x="462" y="192">GROUND CLR</text>
  </g>
  <text id="rpp-r1" x="610" y="128" font-size="9" fill="#22d3ee"  text-anchor="end">0.0°</text>
  <text id="rpp-r2" x="610" y="144" font-size="9" fill="#67e8f9"  text-anchor="end">0.0°</text>
  <text id="rpp-r3" x="610" y="160" font-size="9" fill="#4ade80"  text-anchor="end">--</text>
  <text id="rpp-r4" x="610" y="176" font-size="9" fill="#c4b5fd"  text-anchor="end">OPEN</text>
  <text id="rpp-r5" x="610" y="192" font-size="9" fill="#34d399"  text-anchor="end">OK</text>

  <rect x="452" y="216" width="162" height="4" rx="2" fill="#162040"/>
  <rect id="rpp-prog" x="452" y="216" width="0" height="4" rx="2" fill="#22d3ee"/>

  <circle cx="462" cy="232" r="4" fill="#22d3ee" opacity="0.9"/>
  <text x="471" y="235" fill="#94a3b8" font-size="9">PWR</text>
  <circle cx="508" cy="232" r="4" fill="#4ade80">
    <animate attributeName="opacity" values="0.3;1;0.3" dur="1s" repeatCount="indefinite"/>
  </circle>
  <text x="517" y="235" fill="#94a3b8" font-size="9">RUN</text>
  <circle cx="554" cy="232" r="4" fill="#fbbf24" opacity="0.9"/>
  <text x="563" y="235" fill="#94a3b8" font-size="9">SAFE</text>

  <rect x="452" y="244" width="72"  height="20" rx="5" fill="#0a1428" stroke="#22d3ee" stroke-width="1" opacity="0.6"/>
  <text x="461" y="257" fill="#22d3ee" font-size="9">SCAN MODE</text>
  <rect x="532" y="244" width="72" height="20" rx="5" fill="#0a2018" stroke="#34d399" stroke-width="1"/>
  <text x="541" y="257" fill="#34d399" font-size="9">E-STOP OK</text>

  <text x="454" y="282" fill="#94a3b8" font-size="9">SPEED  85%</text>
  <text x="454" y="296" fill="#94a3b8" font-size="9">TORQ   62%</text>
  <text x="454" y="310" fill="#94a3b8" font-size="9">CYCLE  9.0 s</text>
  <text x="454" y="325" fill="#475569" font-size="8">LEFT PICK · RIGHT PLACE</text>

  <!-- PLC COMM packets -->
  <path id="rpp-bus-fwd" d="M252 242 C300 232 360 212 432 190" fill="none"/>
  <path id="rpp-bus-ret" d="M432 190 C360 212 300 232 252 242" fill="none"/>
  <circle r="3"   fill="#22d3ee">
    <animateMotion dur="1.7s" begin="0s"    repeatCount="indefinite" rotate="auto"><mpath href="#rpp-bus-fwd"/></animateMotion>
  </circle>
  <circle r="2.5" fill="#22d3ee" opacity="0.65">
    <animateMotion dur="1.7s" begin="0.85s" repeatCount="indefinite" rotate="auto"><mpath href="#rpp-bus-fwd"/></animateMotion>
  </circle>
  <circle r="2.5" fill="#a78bfa">
    <animateMotion dur="1.4s" begin="0.4s"  repeatCount="indefinite" rotate="auto"><mpath href="#rpp-bus-ret"/></animateMotion>
  </circle>
  <text x="290" y="224" fill="#64748b" font-size="8">POS / CMD</text>

  <!-- STATE CHIP -->
  <text x="40" y="296" fill="#64748b" font-size="9" letter-spacing="1.5">STATE</text>
  <rect   id="rpp-state-bg"  x="40"  y="300" width="90" height="20" rx="5" fill="#0a2018" stroke="#34d399" stroke-width="1"/>
  <circle id="rpp-state-dot" cx="52" cy="310" r="3" fill="#34d399"/>
  <text   id="rpp-state-lbl" x="61"  y="313" font-size="10" fill="#34d399">HOME</text>

  <text x="40" y="342" fill="#334155" font-size="9">POSE-CTRL · ELBOW-UP · GROUND CLR ENFORCED</text>
</svg>
</div>

<script>
// ─────────────────────────────────────────────────────────────────────────────
// Pose-defined 3-axis robot — NO IK, explicit θ1/θ2 per pose.
// Every pose manually verified: elbow stays high, no ground penetration.
//
// Base: SVG (215, 232). Arm1=80, Arm2=65, tool=14.
// SVG convention: arm drawn along local -Y. rotate(θ) = θ° clockwise from UP.
// Ground at y=255. Tables at y=242. Robot NEVER has elbow below y=200.
// ─────────────────────────────────────────────────────────────────────────────
(function () {
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

  const BX = 215, BY = 232;  // shoulder joint SVG position
  const L1 = 80, L2 = 65;   // arm lengths
  const D2R = Math.PI / 180;

  // Forward kinematics: returns elbow and wrist world positions
  function fk(t1, t2) {
    const elbow = {
      x: BX + L1 * Math.sin(t1 * D2R),
      y: BY - L1 * Math.cos(t1 * D2R),
    };
    const wrist = {
      x: elbow.x + L2 * Math.sin((t1 + t2) * D2R),
      y: elbow.y - L2 * Math.cos((t1 + t2) * D2R),
    };
    return { elbow, wrist };
  }

  // ── Named poses: {θ1, θ2, label, grip, hold, showL, showR} ──
  // All verified safe via FK above.
  //
  // Pose     θ1    θ2   Elbow_y  Wrist_y  Comment
  // HOME      0     0     152      87     straight up, safe
  // APR_L   -44    82     175     200     approach above pick table
  // PICK_L  -48   112     178     242     gripper tip ON left table
  // LIFT     -44    82     175     200     same as APR_L (lift = retract up)
  // TRANS_A   -15   30     170     155     left side of high arc
  // TRANS_B    0    20     152     148     top of arc (high centre)
  // TRANS_C   15    30     170     155     right side of high arc
  // APR_R    44   -82     175     200     approach above place table
  // PLACE_R  48  -112     178     242     gripper tip ON right table
  // RETR     44   -82     175     200     retract up (same as APR_R)

  const POSES = {
    HOME:    { t1:  0,   t2:   0 },
    APR_L:   { t1: -44,  t2:  82 },
    PICK_L:  { t1: -48,  t2: 112 },
    LIFT:    { t1: -44,  t2:  82 },
    TRANS_A: { t1: -15,  t2:  30 },
    TRANS_B: { t1:   0,  t2:  20 },
    TRANS_C: { t1:  15,  t2:  30 },
    APR_R:   { t1:  44,  t2: -82 },
    PLACE_R: { t1:  48,  t2:-112 },
    RETR:    { t1:  44,  t2: -82 },
  };

  // Sequence: from-pose, to-pose, gripper-closed, hold-part, status, duration(s)
  const SEQ = [
    { from:'HOME',    to:'HOME',    g:false, h:false, s:'HOME',      dur:1.0 },
    { from:'HOME',    to:'APR_L',   g:false, h:false, s:'APPROACH',  dur:1.2 },
    { from:'APR_L',   to:'PICK_L',  g:false, h:false, s:'PICKING',   dur:0.7 },
    { from:'PICK_L',  to:'PICK_L',  g:true,  h:true,  s:'PICKING',   dur:0.4 },
    { from:'PICK_L',  to:'LIFT',    g:true,  h:true,  s:'LIFTING',   dur:0.7 },
    { from:'LIFT',    to:'TRANS_A', g:true,  h:true,  s:'MOVING',    dur:0.5 },
    { from:'TRANS_A', to:'TRANS_B', g:true,  h:true,  s:'MOVING',    dur:0.4 },
    { from:'TRANS_B', to:'TRANS_C', g:true,  h:true,  s:'MOVING',    dur:0.4 },
    { from:'TRANS_C', to:'APR_R',   g:true,  h:true,  s:'MOVING',    dur:0.5 },
    { from:'APR_R',   to:'PLACE_R', g:true,  h:true,  s:'PLACING',   dur:0.7 },
    { from:'PLACE_R', to:'PLACE_R', g:false, h:false, s:'PLACING',   dur:0.4 },
    { from:'PLACE_R', to:'RETR',    g:false, h:false, s:'RETURNING', dur:0.7 },
    { from:'RETR',    to:'HOME',    g:false, h:false, s:'READY',     dur:1.2 },
    { from:'HOME',    to:'HOME',    g:false, h:false, s:'HOME',      dur:0.5 },
  ];

  const TOTAL = SEQ.reduce((s, w) => s + w.dur, 0);
  const CUM   = (() => { let a = 0; return SEQ.map(w => { const v = a; a += w.dur; return v; }); })();

  const j1    = document.getElementById('rpp-j1');
  const j2    = document.getElementById('rpp-j2');
  const gripO = document.getElementById('rpp-grip-open');
  const gripC = document.getElementById('rpp-grip-closed');
  const held  = document.getElementById('rpp-held');
  const partL = document.getElementById('rpp-part-left');
  const partR = document.getElementById('rpp-part-right');
  const prog  = document.getElementById('rpp-prog');
  const sBg   = document.getElementById('rpp-state-bg');
  const sDot  = document.getElementById('rpp-state-dot');
  const sLbl  = document.getElementById('rpp-state-lbl');
  const r1    = document.getElementById('rpp-r1');
  const r2el  = document.getElementById('rpp-r2');
  const r3    = document.getElementById('rpp-r3');
  const r4    = document.getElementById('rpp-r4');
  const r5    = document.getElementById('rpp-r5');

  if (!j1 || !j2) return;

  const STATE_C = {
    HOME:      ['#0a2018','#34d399','#34d399','#34d399'],
    APPROACH:  ['#081c2e','#22d3ee','#22d3ee','#22d3ee'],
    PICKING:   ['#081c2e','#22d3ee','#22d3ee','#22d3ee'],
    LIFTING:   ['#0e2008','#4ade80','#4ade80','#4ade80'],
    MOVING:    ['#16103a','#a78bfa','#a78bfa','#a78bfa'],
    PLACING:   ['#201808','#fbbf24','#fbbf24','#fbbf24'],
    RETURNING: ['#16103a','#a78bfa','#a78bfa','#a78bfa'],
    READY:     ['#0a2018','#34d399','#34d399','#34d399'],
  };
  let lastS = '';
  function setChip(s) {
    if (s === lastS) return; lastS = s;
    const c = STATE_C[s] || STATE_C.HOME;
    sBg.setAttribute('fill', c[0]);
    sBg.setAttribute('stroke', c[1]);
    sDot.setAttribute('fill', c[2]);
    sLbl.setAttribute('fill', c[3]);
    sLbl.textContent = s;
    sBg.setAttribute('width', String(s.length * 7.5 + 22));
  }

  // Smooth easing: ease-in-out cubic
  function easeIO(t) { return t < 0.5 ? 4*t*t*t : 1 - Math.pow(-2*t+2,3)/2; }
  function lerp(a, b, t) { return a + (b - a) * t; }

  // Slower near pick/place: use quadratic ease near t=1 for approach/lower segments
  function easeSlow(t) {
    // Extra-slow near end: square the ease
    const e = easeIO(t);
    return e * e * (3 - 2 * e); // smoothstep
  }

  // Ground clearance check (for readout display only — poses are pre-verified safe)
  const GROUND_Y = 255;
  function groundClear(t1, t2) {
    const { elbow } = fk(t1, t2);
    return elbow.y < GROUND_Y - 30; // elbow must be ≥30px above floor
  }

  let t0 = null;
  function tick(ts) {
    if (!t0) t0 = ts;
    const ct = ((ts - t0) / 1000) % TOTAL;

    // Find segment
    let si = SEQ.length - 1;
    for (let i = 0; i < SEQ.length - 1; i++) {
      if (ct >= CUM[i] && ct < CUM[i + 1]) { si = i; break; }
    }
    const seg = SEQ[si];
    const raw = Math.min((ct - CUM[si]) / seg.dur, 1);
    // Use slower ease for pick/place lowering segments
    const useSlow = (seg.s === 'PICKING' && !seg.g) || (seg.s === 'PLACING' && seg.g);
    const t = useSlow ? easeSlow(raw) : easeIO(raw);

    const fromP = POSES[seg.from];
    const toP   = POSES[seg.to];
    const θ1 = lerp(fromP.t1, toP.t1, t);
    const θ2 = lerp(fromP.t2, toP.t2, t);

    // Apply transforms
    j1.setAttribute('transform', `translate(${BX},${BY}) rotate(${θ1.toFixed(2)})`);
    j2.setAttribute('transform', `translate(0,${-L1}) rotate(${θ2.toFixed(2)})`);

    // Gripper
    gripO.style.display = seg.g ? 'none' : '';
    gripC.style.display = seg.g ? '' : 'none';
    held.style.display  = seg.h ? '' : 'none';

    // Workpiece: left visible before grip, right visible after release
    partL.style.display = si < 3  ? '' : 'none';
    partR.style.display = si >= 10 ? '' : 'none';

    // Progress
    prog.setAttribute('width', String(((ct / TOTAL) * 162).toFixed(1)));

    // State chip
    setChip(seg.s);

    // Readouts
    const { elbow } = fk(θ1, θ2);
    r1.textContent = θ1.toFixed(1) + '°';
    r2el.textContent = θ2.toFixed(1) + '°';
    r3.textContent = (GROUND_Y - elbow.y).toFixed(0) + 'px';
    r4.textContent = seg.g ? 'CLOSED' : 'OPEN';
    r5.textContent = groundClear(θ1, θ2) ? 'OK ✓' : 'WARN';

    requestAnimationFrame(tick);
  }
  requestAnimationFrame(tick);
})();
</script>

<style>
.rpp-wrapper { display: block; width: 100%; }
</style>
