    <text x="462" y="144">J2  (ELBOW)</text>
    <text x="462" y="160">ELBOW HT</text>
    <text x="462" y="176">GRIPPER</text>
    <text x="462" y="192">GROUND CLR</text>
  </g>
  <text id="rpp-r1" x="610" y="128" font-size="9" fill="#22d3ee"  text-anchor="end">0.0°</text>
  <text id="rpp-r2" x="610" y="144" font-size="9" fill="#67e8f9"  text-anchor="end">0.0°</text>
  <text id="rpp-r3" x="610" y="160" font-size="9" fill="#4ade80"  text-anchor="end">--</text>
  <text id="rpp-r4" x="610" y="176" font-size="9" fill="#c4b5fd"  text-anchor="end">OPEN</text>
