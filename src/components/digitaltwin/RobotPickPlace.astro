    <animate attributeName="opacity" values="0.3;1;0.3" dur="1s" repeatCount="indefinite"/>
  </circle>
  <text x="517" y="235" fill="#94a3b8" font-size="9">RUN</text>
  <circle cx="554" cy="232" r="4" fill="#fbbf24" opacity="0.9"/>
  <text x="563" y="235" fill="#94a3b8" font-size="9">SAFE</text>

  <rect x="452" y="244" width="72"  height="20" rx="5" fill="#0a1428" stroke="#22d3ee" stroke-width="1" opacity="0.6"/>
  <text x="461" y="257" fill="#22d3ee" font-size="9">SCAN MODE</text>
  <rect x="532" y="244" width="72" height="20" rx="5" fill="#0a2018" stroke="#34d399" stroke-width="1"/>
  <text x="541" y="257" fill="#34d399" font-size="9">E-STOP OK</text>

  <text x="454" y="282" fill="#94a3b8" font-size="9">SPEED  85%</text>
  <text x="454" y="296" fill="#94a3b8" font-size="9">TORQ   62%</text>
  <text x="454" y="310" fill="#94a3b8" font-size="9">CYCLE  9.0 s</text>
  <text x="454" y="325" fill="#475569" font-size="8">LEFT PICK · RIGHT PLACE</text>

  <!-- PLC COMM packets -->
  <path id="rpp-bus-fwd" d="M252 242 C300 232 360 212 432 190" fill="none"/>
  <path id="rpp-bus-ret" d="M432 190 C360 212 300 232 252 242" fill="none"/>
  <circle r="3"   fill="#22d3ee">
    <animateMotion dur="1.7s" begin="0s"    repeatCount="indefinite" rotate="auto"><mpath href="#rpp-bus-fwd"/></animateMotion>
  </circle>
  <circle r="2.5" fill="#22d3ee" opacity="0.65">
    <animateMotion dur="1.7s" begin="0.85s" repeatCount="indefinite" rotate="auto"><mpath href="#rpp-bus-fwd"/></animateMotion>
  </circle>
  <circle r="2.5" fill="#a78bfa">
    <animateMotion dur="1.4s" begin="0.4s"  repeatCount="indefinite" rotate="auto"><mpath href="#rpp-bus-ret"/></animateMotion>
  </circle>
  <text x="290" y="224" fill="#64748b" font-size="8">POS / CMD</text>

  <!-- STATE CHIP -->
  <text x="40" y="296" fill="#64748b" font-size="9" letter-spacing="1.5">STATE</text>
  <rect   id="rpp-state-bg"  x="40"  y="300" width="90" height="20" rx="5" fill="#0a2018" stroke="#34d399" stroke-width="1"/>
  <circle id="rpp-state-dot" cx="52" cy="310" r="3" fill="#34d399"/>
  <text   id="rpp-state-lbl" x="61"  y="313" font-size="10" fill="#34d399">HOME</text>

  <text x="40" y="342" fill="#334155" font-size="9">IK-CTRL &middot; ELBOW-UP &middot; GROUND CLR ENFORCED</text>
</svg>
</div>

<script>
// ─────────────────────────────────────────────────────────────────────────────
// Real 2-link planar IK for the 3-axis pick-and-place robot.
// θ1/θ2 are solved analytically each frame from the interpolated wrist target,
// so the end effector lands EXACTLY on PICK=(102,235) and PLACE=(332,235).
//
// Base: SVG (215, 232). Arm1=80, Arm2=65. SVG +Y is down.
//   D  = hypot(tx-BX, ty-BY)
//   θ2 = acos((D²-L1²-L2²)/(2·L1·L2))                       (± branch)
//   θ1 = atan2(dy,dx) - atan2(L2·sin θ2, L1+L2·cos θ2)
// Elbow-up: keep the branch with the smaller elbow Y (higher off floor).
// Convert to SVG rotate(): θ1_rot = θ1 + 90° (arm drawn along -Y), θ2_rot = θ2.
//
// MOTION: chained phases. Holds park the arm; chains move it along a polyline
// under ONE cumulative-distance quintic smoothstep — accelerate from rest,
// cruise through intermediate waypoints without stopping, decelerate onto the
// final target. The transfer arc is split at T_B (the straight-arm apex where
// both IK branches meet) so the singular configuration is crossed at rest.
// 9.0 s cycle; HOME = apex → the cycle returns to a bit-identical pose.
//
// MOUNTS: the page renders this component twice (Systems + CaseStudies). The
// script never calls global getElementById — it finds every [data-rpp] wrapper
// and queries each mount's own <svg> subtree, so both robots animate.
// ─────────────────────────────────────────────────────────────────────────────
(function () {
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

  const BX = 215, BY = 232;  // shoulder joint SVG position
  const L1 = 80, L2 = 65;   // arm lengths
  const GROUND_Y = 255;     // floor line — elbow must stay above it
  const D2R = Math.PI / 180;

  // Inverse kinematics: solve θ1/θ2 (radians, SVG frame +Y down) for target (tx,ty)
  function ik(tx, ty) {
    const dx = tx - BX, dy = ty - BY;
    const D = Math.hypot(dx, dy);
    if (D < Math.abs(L1 - L2) || D > L1 + L2) return null;
    const c2 = (D * D - L1 * L1 - L2 * L2) / (2 * L1 * L2);
    const a2 = Math.acos(Math.max(-1, Math.min(1, c2)));
    // two branches: θ2 = ±a2
    const m1 = Math.atan2(dy, dx) - Math.atan2(L2 * Math.sin(a2),  L1 + L2 * Math.cos(a2));
    const m2 = Math.atan2(dy, dx) - Math.atan2(L2 * Math.sin(-a2), L1 + L2 * Math.cos(-a2));
    const e1y = BY + L1 * Math.sin(m1);
    const e2y = BY + L1 * Math.sin(m2);
    // elbow-up: pick the branch whose elbow is higher (smaller Y)
    return e1y <= e2y ? { t1: m1, t2: a2 } : { t1: m2, t2: -a2 };
  }

  // Forward kinematics (for readouts): returns elbow + wrist world positions
  function fk(t1, t2) {
    const elbow = { x: BX + L1 * Math.cos(t1), y: BY + L1 * Math.sin(t1) };
    const wrist = { x: elbow.x + L2 * Math.cos(t1 + t2), y: elbow.y + L2 * Math.sin(t1 + t2) };
    return { elbow, wrist };
  }

  // Quintic smoothstep: zero velocity AND zero acceleration at both ends
  function ss(t) { return t * t * t * (10 + t * (-15 + 6 * t)); }
  function lerp(a, b, t) { return a + (b - a) * t; }

  // Ground clearance check (readout only — IK keeps elbow-up, always safe)
  function groundClear(t1, t2) {
    const { elbow } = fk(t1, t2);
    return elbow.y < GROUND_Y - 30;
  }

  // ── Phase table (9.0 s cycle) ──────────────────────────────────────────────
  // Each phase: `d` duration (s), `pts` polyline. A 1-point phase is a HOLD.
  // A ≥2-point phase is a CHAIN — one eased sweep through the whole polyline.
  // Per-point {g,h,s}: gripper state, held-part state, status label.
  // The transfer arc is split into two chains at T_B (the straight-arm apex),
  // so the singular apex configuration is crossed at rest.
  const PHASES = [
    // HOLD — HOME (0.7 s)
    { d: 0.7, pts: [
      { x: 215, y: 87,  g: false, h: false, s: 'HOME' } ] },
    // CHAIN — HOME → APR_L → PICK (1.9 s): long slow decel onto PICK
    { d: 1.9, pts: [
      { x: 215, y: 87,  g: false, h: false, s: 'APPROACH' },
      { x: 102, y: 185, g: false, h: false, s: 'APPROACH' },
      { x: 102, y: 235, g: false, h: false, s: 'PICKING' } ] },
    // HOLD — PICK + grip close (0.4 s)
    { d: 0.4, pts: [
      { x: 102, y: 235, g: true,  h: true,  s: 'PICKING' } ] },
    // CHAIN — PICK → LIFT → T_A → T_B apex (1.6 s): decel onto the apex
    { d: 1.6, pts: [
      { x: 102, y: 235, g: true,  h: true,  s: 'LIFTING' },
      { x: 102, y: 185, g: true,  h: true,  s: 'LIFTING' },
      { x: 160, y: 115, g: true,  h: true,  s: 'MOVING' },
      { x: 215, y: 87,  g: true,  h: true,  s: 'MOVING' } ] },
    // CHAIN — T_B apex → T_C → APR_R → PLACE (1.6 s): accel off apex, decel onto PLACE
    { d: 1.6, pts: [
      { x: 215, y: 87,  g: true,  h: true,  s: 'MOVING' },
      { x: 270, y: 115, g: true,  h: true,  s: 'MOVING' },
      { x: 332, y: 185, g: true,  h: true,  s: 'MOVING' },
      { x: 332, y: 235, g: true,  h: true,  s: 'PLACING' } ] },
    // HOLD — PLACE + grip open / release (0.4 s)
    { d: 0.4, pts: [
      { x: 332, y: 235, g: false, h: false, s: 'PLACING' } ] },
    // CHAIN — PLACE → RETR → HOME (1.9 s)
    { d: 1.9, pts: [
      { x: 332, y: 235, g: false, h: false, s: 'RETURNING' },
      { x: 332, y: 185, g: false, h: false, s: 'RETURNING' },
      { x: 215, y: 87,  g: false, h: false, s: 'READY' } ] },
    // HOLD — HOME (0.5 s)
    { d: 0.5, pts: [
      { x: 215, y: 87,  g: false, h: false, s: 'HOME' } ] },
  ];

  const TOTAL = PHASES.reduce((s, p) => s + p.d, 0);
  const PHS = (() => { let a = 0; return PHASES.map(p => { const v = a; a += p.d; return v; }); })();
  // Cumulative arc length along each phase's polyline
  const CLEN = PHASES.map(p => {
    const c = [0];
    for (let i = 1; i < p.pts.length; i++)
      c.push(c[i - 1] + Math.hypot(p.pts[i].x - p.pts[i - 1].x, p.pts[i].y - p.pts[i - 1].y));
    return c;
  });

  // Point at normalized progress u along a phase: single-point = hold (u unused);
  // chain = ease the cumulative arc length with the s-curve, then interpolate.
  function sample(p, clen, u) {
    if (p.pts.length === 1) return { x: p.pts[0].x, y: p.pts[0].y, k: 0 };
    const L = clen[clen.length - 1];
    const d = L === 0 ? 0 : ss(u) * L;
    let k = 0;
    while (k < clen.length - 2 && d > clen[k + 1]) k++;
    const seg = clen[k + 1] - clen[k];
    const t = seg > 0 ? Math.min(Math.max((d - clen[k]) / seg, 0), 1) : 0;
    return {
      x: p.pts[k].x + (p.pts[k + 1].x - p.pts[k].x) * t,
      y: p.pts[k].y + (p.pts[k + 1].y - p.pts[k].y) * t,
      k,
    };
  }

  const STATE_C = {
    HOME:      ['#0a2018','#34d399','#34d399','#34d399'],
    APPROACH:  ['#081c2e','#22d3ee','#22d3ee','#22d3ee'],
    PICKING:   ['#081c2e','#22d3ee','#22d3ee','#22d3ee'],
    LIFTING:   ['#0e2008','#4ade80','#4ade80','#4ade80'],
    MOVING:    ['#16103a','#a78bfa','#a78bfa','#a78bfa'],
    PLACING:   ['#201808','#fbbf24','#fbbf24','#fbbf24'],
    RETURNING: ['#16103a','#a78bfa','#a78bfa','#a78bfa'],
    READY:     ['#0a2018','#34d399','#34d399','#34d399'],
  };

  // ── One fully independent animation loop per mounted instance ──────────────
  document.querySelectorAll('[data-rpp]').forEach((root) => {
    const svg = root.querySelector('svg');
    if (!svg) return;
    const j1    = svg.querySelector('#rpp-j1');
    const j2    = svg.querySelector('#rpp-j2');
    const gripO = svg.querySelector('#rpp-grip-open');
    const gripC = svg.querySelector('#rpp-grip-closed');
    const held  = svg.querySelector('#rpp-held');
    const partL = svg.querySelector('#rpp-part-left');
    const partR = svg.querySelector('#rpp-part-right');
    const prog  = svg.querySelector('#rpp-prog');
    const sBg   = svg.querySelector('#rpp-state-bg');
    const sDot  = svg.querySelector('#rpp-state-dot');
    const sLbl  = svg.querySelector('#rpp-state-lbl');
    const r1    = svg.querySelector('#rpp-r1');
    const r2el  = svg.querySelector('#rpp-r2');
    const r3    = svg.querySelector('#rpp-r3');
    const r4    = svg.querySelector('#rpp-r4');
    const r5    = svg.querySelector('#rpp-r5');
    if (!j1 || !j2) return;

    let lastS = '';
    function setChip(s) {
      if (s === lastS) return; lastS = s;
      const c = STATE_C[s] || STATE_C.HOME;
      sBg.setAttribute('fill', c[0]);
      sBg.setAttribute('stroke', c[1]);
      sDot.setAttribute('fill', c[2]);
      sLbl.setAttribute('fill', c[3]);
      sLbl.textContent = s;
      sBg.setAttribute('width', String(s.length * 7.5 + 22));
    }

    let prev = null;
    let t0 = null;
    function tick(ts) {
      if (!t0) t0 = ts;
      const ct = ((ts - t0) / 1000) % TOTAL;

      // Active phase
      let pi = PHASES.length - 1;
      for (let i = 0; i < PHASES.length; i++) {
        if (ct >= PHS[i] && ct < PHS[i] + PHASES[i].d) { pi = i; break; }
      }
      const ph = PHASES[pi];
      const u = Math.min(Math.max((ct - PHS[pi]) / ph.d, 0), 1);
      const sm = sample(ph, CLEN[pi], u);
      const st = ph.pts[sm.k + 1] || ph.pts[sm.k];

      const sol = ik(sm.x, sm.y);
      if (sol) prev = sol;
      if (!prev) { requestAnimationFrame(tick); return; }
      const { t1, t2 } = prev;

      // SVG: arm1 drawn along -Y → rotate θ1+90; arm2 local → rotate θ2
      const t1d = (t1 + Math.PI / 2) / D2R;
      const t2d = t2 / D2R;
      j1.setAttribute('transform', `translate(${BX},${BY}) rotate(${t1d.toFixed(2)})`);
      j2.setAttribute('transform', `translate(0,${-L1}) rotate(${t2d.toFixed(2)})`);

      // Gripper
      gripO.style.display = st.g ? 'none' : '';
      gripC.style.display = st.g ? '' : 'none';
      held.style.display  = st.h ? '' : 'none';

      // Workpiece: left part shown until grip closes (phases 0–1),
      // right part shown after release (phases 5–7)
      partL.style.display = pi < 2 ? '' : 'none';
      partR.style.display = pi >= 5 ? '' : 'none';

      // Progress
      prog.setAttribute('width', String(((ct / TOTAL) * 162).toFixed(1)));

      // State chip
      setChip(st.s);

      // Readouts
      const { elbow } = fk(t1, t2);
      r1.textContent = t1d.toFixed(1) + '°';
      r2el.textContent = t2d.toFixed(1) + '°';
      r3.textContent = (GROUND_Y - elbow.y).toFixed(0) + 'px';
      r4.textContent = st.g ? 'CLOSED' : 'OPEN';
      r5.textContent = groundClear(t1, t2) ? 'OK ✓' : 'WARN';

      requestAnimationFrame(tick);
    }
    requestAnimationFrame(tick);
  });
})();
</script>

<style>
.rpp-wrapper { display: block; width: 100%; }
</style>
