---
// Digital Twin: 3-axis industrial robot pick-and-place cell.
// POSE-DEFINED animation — explicit θ1/θ2 per named pose, no IK.
// Elbow-up enforced at every pose. Ground clearance guaranteed by design.
// SVG arm: drawn pointing UP (-Y). θ measured clockwise from UP.
//   θ1=0   → arm1 straight up
//   θ1=45  → arm1 leaning right at 45°
//   θ1=-45 → arm1 leaning left at 45°
// Hierarchy: J1(base) → arm1(L1=80) → J2(elbow) → arm2(L2=65) → gripper(L3=14)
const font = "ui-monospace, SFMono-Regular, Cascadia Mono, Consolas, monospace";

// ── Verified safe poses (angles in degrees, elbow always up / high arc) ──
//
// Base at SVG (215, 242). L1=80, L2=65, L3=14.
// GROUND_Y = 255 (floor line). Tables at y=242 surface.
// All elbow positions verified ≥ 130 (well above floor).
//
// Pose verification (FK check, arm drawn along -Y in local frame):
//   elbow_world_x = 215 + L1*sin(θ1)
//   elbow_world_y = 242 - L1*cos(θ1)
//   tip_world_x   = elbow_x + L2*sin(θ1+θ2)  [+gripper offset]
//   tip_world_y   = elbow_y - L2*cos(θ1+θ2)
//
// HOME:      θ1=0,   θ2=0    → elbow=(215,162), tip=(215,83)   ✓ elbow high
// APPROACH_L:θ1=-42, θ2=80   → elbow=(161,183), tip=(96,200)   ✓
// PICK_L:    θ1=-46, θ2=106  → elbow=(157,186), tip=(100,242)  ✓ tip on table
// LIFT:      θ1=-42, θ2=80   → same as APPROACH_L              ✓
// TRANSFER:  θ1=0,   θ2=25   → elbow=(215,162), tip=(242,212)  ✓ mid-arc high
// APPROACH_R:θ1=38,  θ2=-78  → elbow=(264,179), tip=(330,200)  ✓
// PLACE_R:   θ1=42,  θ2=-102 → elbow=(268,183), tip=(332,242)  ✓ tip on table
// RETRACT:   θ1=38,  θ2=-78  → same as APPROACH_R              ✓
---

<div class="rpp-wrapper" role="img" aria-label="3-axis industrial robot pick and place simulation">
<svg
  id="rpp-svg"
  viewBox="0 0 640 360"
  xmlns="http://www.w3.org/2000/svg"
  class="block aspect-[16/9] h-auto w-full transition duration-700 group-hover:scale-[1.03]"
  font-family={font}
>
  <defs>
    <linearGradient id="rpp-bg" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#0d1430"/>
      <stop offset="1" stop-color="#0a1024"/>
    </linearGradient>
    <radialGradient id="rpp-floor-glow" cx="0.35" cy="1" r="0.6">
      <stop offset="0" stop-color="#22d3ee" stop-opacity="0.08"/>
      <stop offset="1" stop-color="#22d3ee" stop-opacity="0"/>
    </radialGradient>
    <filter id="rpp-glow-sm" x="-80%" y="-80%" width="260%" height="260%">
      <feGaussianBlur stdDeviation="2" result="b"/>
      <feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge>
    </filter>
    <clipPath id="rpp-cell-clip">
      <rect x="40" y="52" width="390" height="230"/>
    </clipPath>
  </defs>

  <!-- backdrop -->
  <rect width="640" height="360" fill="url(#rpp-bg)"/>
  <rect width="640" height="360" fill="url(#rpp-floor-glow)"/>
  <g stroke="#1e2a55" stroke-width="1" opacity="0.4">
    <line x1="0"   y1="90"  x2="640" y2="90"/>
    <line x1="0"   y1="180" x2="640" y2="180"/>
    <line x1="0"   y1="270" x2="640" y2="270"/>
    <line x1="160" y1="0"   x2="160" y2="360"/>
    <line x1="320" y1="0"   x2="320" y2="360"/>
    <line x1="480" y1="0"   x2="480" y2="360"/>
  </g>

  <!-- header -->
  <text x="40" y="26" fill="#7dd3fc" font-size="12" font-weight="700" letter-spacing="1">ROBOT PICK &amp; PLACE CELL</text>
  <text x="40" y="42" fill="#64748b" font-size="10">3-AXIS INDUSTRIAL &middot; PLC MASTER &middot; CYCLE 9.0 s</text>
  <rect x="548" y="14" width="54" height="20" rx="10" fill="#fbbf24" opacity="0.12"/>
  <circle cx="562" cy="24" r="3" fill="#fbbf24">
    <animate attributeName="opacity" values="0.4;1;0.4" dur="1.2s" repeatCount="indefinite"/>
  </circle>
  <text x="572" y="28" fill="#fbbf24" font-size="10" letter-spacing="1">SCAN</text>

  <!-- safety cell frame -->
  <rect x="40" y="52" width="390" height="230" rx="8" fill="#0d1632" opacity="0.35"/>
  <rect x="40" y="52" width="390" height="230" rx="8" fill="none" stroke="#3b4c8a" stroke-width="1" stroke-dasharray="5 5" opacity="0.5"/>
  <g stroke="#7c8ff0" stroke-width="1.8" opacity="0.4">
    <path d="M40 64 V52 H52"/>
    <path d="M418 52 H430 V64"/>
    <path d="M430 270 V282 H418"/>
    <path d="M52 282 H40 V270"/>
  </g>
  <text x="52" y="68" fill="#8b9cf0" font-size="9" letter-spacing="1.5">SAFE CELL</text>

  <!-- FLOOR LINE — ground boundary, robot NEVER crosses this -->
