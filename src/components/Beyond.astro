---
import { ui } from '../i18n/ui';

const t = ui.en;
---

<section id="beyond" class="py-20 sm:py-24" aria-labelledby="beyond-heading">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="grid gap-12 lg:grid-cols-5 lg:gap-16">

      <!-- Left: text content (unchanged) -->
      <div class="lg:col-span-2">
        <p class="text-sm font-semibold uppercase tracking-widest text-indigo-500" data-i18n="beyond.kicker">{t.beyond.kicker}</p>
        <h2 id="beyond-heading" class="mt-2 text-3xl font-bold tracking-tight text-[#15152a] sm:text-4xl" data-i18n="beyond.title">
          {t.beyond.title}
        </h2>
        <p class="mt-4 text-base leading-relaxed text-slate-500 sm:text-lg" data-i18n="beyond.intro">
          {t.beyond.intro}
        </p>

        <h3 class="mt-8 text-sm font-bold uppercase tracking-wider text-slate-700" data-i18n="beyond.mindsetTitle">
          {t.beyond.mindsetTitle}
        </h3>
        <ul class="mt-4 space-y-3">
          {t.beyond.mindset.map((item, i) => (
            <li class="flex items-start gap-2.5 text-sm text-slate-600">
              <svg class="mt-0.5 h-5 w-5 shrink-0 text-indigo-500" fill="none" viewBox="0 0 24 24"
                stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
              <span data-i18n={`beyond.mindset.${i}`}>{item}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- Right: three tidy columns flowing top → bottom, shuffled images -->
      <div class="lg:col-span-3">
        <div class="waterfall" id="beyond-waterfall">
          {t.beyond.gallery.map((photo, i) => (
            <figure class="waterfall-card" data-card={i}>
              <img
                src={photo.src}
                alt={photo.alt}
                width="800"
                height="800"
                loading="lazy"
                decoding="async"
                class="waterfall-img"
                data-i18n-alt={`beyond.gallery.${i}.alt`}
              />
              <figcaption class="waterfall-caption">
                <span data-i18n={`beyond.gallery.${i}.label`}>{photo.label}</span>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>

    </div>
  </div>
</section>

<style>
/* ─────────────────────────────────────────────────────────────
   FLOWING IMAGE COLUMNS
   The photo cards are split into 3 tidy vertical lanes that
   stream continuously from top to bottom — cards enter above
   the viewport, drift straight down inside their lane with a
   small in-lane sway, exit below, then recycle invisibly.
   Pure transform animation (translate3d / rotate / scale) is
   driven in JS; the image order is shuffled on every load so
   each reload lands the photos in a different random lane/slot.
   ───────────────────────────────────────────────────────────── */

.waterfall {
  position: relative;
  height: 440px;
  overflow: hidden;
  border-radius: 24px;
  isolation: isolate;
  background:
    radial-gradient(ellipse 75% 60% at 50% 40%, rgba(99, 102, 241, 0.10), transparent 72%),
    radial-gradient(ellipse 50% 45% at 14% 18%, rgba(34, 211, 238, 0.08), transparent 70%),
    radial-gradient(ellipse 50% 45% at 88% 24%, rgba(167, 139, 250, 0.09), transparent 70%),
    linear-gradient(rgba(99, 102, 241, 0.045) 1px, transparent 1px),
    linear-gradient(90deg, rgba(99, 102, 241, 0.045) 1px, transparent 1px),
    rgba(255, 255, 255, 0.4);
  background-size: auto, auto, auto, 48px 48px, 48px 48px, auto;
  border: 1px solid rgba(255, 255, 255, 0.65);
  box-shadow:
    0 1px 2px rgba(30, 27, 75, 0.05),
    0 24px 60px -24px rgba(30, 27, 75, 0.16),
    inset 0 1px 0 rgba(255, 255, 255, 0.85);
}

.waterfall-card {
  position: absolute;
  top: 0;
  left: 0;
  margin: 0;
  width: clamp(130px, 26vw, 176px);
  aspect-ratio: 3 / 4;
  border-radius: 18px;
  overflow: hidden;
  opacity: 0; /* JS paints them in on the first frame */
  background: rgba(255, 255, 255, 0.65);
  border: 1px solid rgba(255, 255, 255, 0.7);
  box-shadow:
    0 2px 6px rgba(30, 27, 75, 0.07),
    0 18px 44px -18px rgba(30, 27, 75, 0.22);
  transform-origin: center;
  will-change: transform, opacity;
  transition:
    box-shadow 0.35s var(--ease-spatial),
    border-color 0.35s var(--ease-spatial);
}

.waterfall-img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  filter: blur(var(--blur, 0px));
  transition: filter 0.4s var(--ease-spatial);
}

/* thin premium frame line around the photo */
.waterfall-card::after {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: inherit;
  box-shadow: inset 0 0 0 1px rgba(99, 102, 241, 0.16);
  pointer-events: none;
}

.waterfall-caption {
  position: absolute;
  inset-inline: 0;
  bottom: 0;
  padding: 26px 12px 10px;
  background: linear-gradient(to top, rgba(15, 18, 40, 0.62), rgba(15, 18, 40, 0.08) 70%, transparent);
  pointer-events: none;
}

.waterfall-caption span {
  display: block;
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.01em;
  color: #ffffff;
}

/* Hover: JS slows + lifts the hovered card toward the viewer;
   this CSS supplies the glow treatment only */
.waterfall-card.is-hovered {
  border-color: rgba(99, 102, 241, 0.55);
  box-shadow:
    0 4px 10px rgba(30, 27, 75, 0.1),
    0 26px 60px -18px rgba(99, 102, 241, 0.38),
    0 0 0 1px rgba(99, 102, 241, 0.22);
}

.waterfall-card.is-hovered .waterfall-img {
  filter: blur(0);
}

@media (max-width: 479px) {
  .waterfall-card { width: clamp(96px, 28vw, 130px); }
}

@media (min-width: 640px) {
  .waterfall { height: 500px; }
}

@media (min-width: 1024px) {
  .waterfall { height: 540px; }
}

/* Reduced motion: show a tidy static grid instead of the waterfall */
@media (prefers-reduced-motion: reduce) {
  .waterfall {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    height: auto;
    overflow: visible;
    background: none;
    border: none;
    box-shadow: none;
  }

  .waterfall-card {
    position: static;
    width: 100%;
    aspect-ratio: 3 / 4;
    opacity: 1;
  }
}

@media (min-width: 1024px) and (prefers-reduced-motion: reduce) {
  .waterfall { grid-template-columns: repeat(3, 1fr); }
}
</style>

<script>
// ─────────────────────────────────────────────────────────────────────────────
// Flowing image columns: the photo cards are split into 3 tidy vertical lanes
// (left / center / right) that stream continuously from top to bottom. Cards
// enter above the viewport, drift straight down inside their lane with a small
// in-lane sway, exit below and recycle invisibly — so no lane ever visibly
// resets. The card order is shuffled on every load, so the photos land in
// random lanes/slots each time. Hover slows + lifts the hovered card while the
// rest keep flowing. Transforms only (translate3d / rotate / scale) →
// compositor-friendly, ~60fps.
// ─────────────────────────────────────────────────────────────────────────────
(function () {
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

  const container = document.getElementById('beyond-waterfall');
  if (!container) return;
  const cards = Array.from(container.querySelectorAll<HTMLElement>('.waterfall-card'));
  if (!cards.length) return;

  // Shuffle the card order → random lane/slot for each photo on every load
  for (let i = cards.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [cards[i], cards[j]] = [cards[j], cards[i]];
  }

  // 3 even lanes; all cards in a lane share its speed so spacing stays tidy
  const LANES = [
    { frac: 1 / 6, dur: 14.0, amp: 6, rot: -1.2, wob: 0.30, scl: 1.00, opa: 0.98, blr: 0.0 },
    { frac: 3 / 6, dur: 16.5, amp: 8, rot:  0.9, wob: 0.36, scl: 1.02, opa: 1.00, blr: 0.0 },
    { frac: 5 / 6, dur: 15.0, amp: 5, rot: -0.7, wob: 0.33, scl: 0.99, opa: 0.96, blr: 0.4 },
  ];

  const MARGIN = 24;      // off-screen runway above/below the viewport
  const HOVER_SLOW = 0.3; // speed multiplier while a card is hovered

  // Round-robin: distribute the shuffled cards evenly across the 3 lanes
  const laneOf: number[] = [];
  const slotOf: number[] = [];
  const laneCounts = [0, 0, 0];
  cards.forEach((_, i) => {
    const lane = i % LANES.length;
    laneOf.push(lane);
    slotOf.push(laneCounts[lane]++);
  });

  const cardW: number[] = [];
  const cardH: number[] = [];
  cards.forEach((card, i) => {
    card.style.setProperty('--blur', `${LANES[laneOf[i]].blr}px`);
    cardW.push(card.offsetWidth);
    cardH.push(card.offsetHeight);
  });

  let vh = container.clientHeight;
  let availW = container.clientWidth;
  function measure() {
    vh = container.clientHeight;
    availW = container.clientWidth;
  }
  measure();
  window.addEventListener('resize', measure);

  // Hover: only the hovered card reacts; the rest keep flowing
  let hovered = -1;
  cards.forEach((card, i) => {
    card.addEventListener('mouseenter', () => { hovered = i; });
    card.addEventListener('mouseleave', () => { if (hovered === i) hovered = -1; });
  });
  container.addEventListener('mouseleave', () => { hovered = -1; });

  // Only animate while the section is near the viewport
  let inView = true;
  const io = new IntersectionObserver(
    (entries) => { inView = entries[0].isIntersecting; },
    { rootMargin: '200px' }
  );
  io.observe(container);

  const times: number[] = cards.map(() => 0);
  let last = null as number | null;
  function tick(ts: number) {
    const now = ts / 1000;
    if (last === null) last = now;
    let dt = now - last;
    last = now;
    if (dt > 0.05) dt = 0.05; // clamp gaps (tab switch / long frames)

    if (inView) {
      for (let i = 0; i < cards.length; i++) {
        const card = cards[i];
        const lane = LANES[laneOf[i]];
        const hover = hovered === i;

        times[i] += dt * (hover ? HOVER_SLOW : 1);
        // slot phase keeps cards in a lane evenly spaced; shared lane speed
        const p = ((times[i] / lane.dur) + slotOf[i] / laneCounts[laneOf[i]]) % 1;

        // Vertical: enter above the viewport, flow down, exit below, recycle
        const cycle = vh + cardH[i] + 2 * MARGIN;
        const y = -cardH[i] - MARGIN + p * cycle;
        // Gentle in-lane sway
        const sway = Math.sin(p * Math.PI * 2 * lane.wob + i * 1.7);
        const x = lane.frac * Math.max(availW - cardW[i], 0) + lane.amp * sway;

        const rot = lane.rot + 0.8 * Math.sin(p * Math.PI * 2 * lane.wob + i * 1.7 + 0.9);
        const scale = lane.scl * (hover ? 1.12 : 1);
        const opacity = Math.min(1, Math.max(0.55, lane.opa * (0.85 + 0.15 * Math.sin(p * Math.PI))));

        card.style.transform =
          `translate3d(${x.toFixed(1)}px, ${y.toFixed(1)}px, 0) ` +
          `rotate(${rot.toFixed(2)}deg) scale(${scale.toFixed(3)})`;
        card.style.opacity = opacity.toFixed(3);
        card.style.zIndex = String(hover ? 30 : 10);
        card.classList.toggle('is-hovered', hover);
      }
    }
    requestAnimationFrame(tick);
  }
  requestAnimationFrame(tick);
})();
</script>
