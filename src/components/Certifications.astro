---
import { ui } from '../i18n/ui';

const t = ui.en;

const accentStyles: Record<string, { card: string; title: string }> = {
  blue: {
    card: 'border-emerald-500/35 from-emerald-500/15 to-transparent',
    title: 'text-emerald-300',
  },
  emerald: {
    card: 'border-lime-400/30 from-lime-400/10 to-transparent',
    title: 'text-lime-300',
  },
  violet: {
    card: 'border-teal-400/30 from-teal-500/10 to-transparent',
    title: 'text-teal-300',
  },
};
---

<section
  id="certifications"
  class="border-t border-slate-800/60 py-20 sm:py-24"
  aria-labelledby="certifications-heading"
>
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl">
      <p class="text-sm font-semibold uppercase tracking-widest text-emerald-400" data-i18n="certs.kicker">{t.certs.kicker}</p>
      <h2 id="certifications-heading" class="mt-2 text-3xl font-bold tracking-tight text-white sm:text-4xl" data-i18n="certs.title">
        {t.certs.title}
      </h2>
      <p class="mt-4 text-base text-slate-400 sm:text-lg" data-i18n="certs.subtitle">
        {t.certs.subtitle}
      </p>
    </div>

    <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" role="list">
      {
        t.certs.licenses.map((lic, i) => (
          <li class="relative overflow-hidden rounded-2xl border border-slate-800 bg-gradient-to-b from-slate-900/80 to-slate-950 p-6 transition hover:border-emerald-500/40">
            <div class="flex items-start justify-between gap-3">
              <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-emerald-500/15 text-emerald-400" aria-hidden="true">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
                  />
                </svg>
              </div>
              <span class="rounded-md border border-slate-700 bg-slate-900 px-2 py-0.5 font-mono text-[10px] text-slate-400">
                {lic.nameJa}
              </span>
            </div>
            <h3 class="mt-4 text-base font-bold text-white" data-i18n={`certs.licenses.${i}.name`}>{lic.name}</h3>
            <p class="mt-1 text-xs font-medium text-emerald-300/80" data-i18n={`certs.licenses.${i}.issuer`}>{lic.issuer}</p>
            <p class="mt-3 text-sm text-slate-500" data-i18n={`certs.licenses.${i}.note`}>{lic.note}</p>
          </li>
        ))
      }
    </ul>

    <div class="mt-14">
      <h3 class="text-lg font-semibold text-white" data-i18n="certs.stackTitle">{t.certs.stackTitle}</h3>
      <div class="mt-6 grid gap-5 lg:grid-cols-3">
        {
          t.certs.categories.map((cat, i) => {
            const styles = accentStyles[cat.accent];
            return (
              <div class:list={['rounded-2xl border bg-gradient-to-b p-6', styles.card]}>
                <h4 class:list={['text-sm font-bold uppercase tracking-wider', styles.title]} data-i18n={`certs.categories.${i}.title`}>
                  {cat.title}
                </h4>
                <ul class="mt-4 flex flex-wrap gap-2" role="list">
                  {cat.skills.map((skill, j) => (
                    <li
                      class="rounded-lg border border-slate-700/70 bg-slate-950/60 px-3 py-1.5 text-xs font-medium text-slate-300"
                      data-i18n={`certs.categories.${i}.skills.${j}`}
                    >
                      {skill}
                    </li>
                  ))}
                </ul>
              </div>
            );
          })
        }
      </div>
    </div>
  </div>
</section>
