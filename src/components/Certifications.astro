---
import { ui } from '../i18n/ui';

const t = ui.en;
---

<section id="certifications" class="py-20 sm:py-24" aria-labelledby="certifications-heading">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl">
      <p class="text-sm font-semibold uppercase tracking-widest text-indigo-500" data-i18n="certs.kicker">{t.certs.kicker}</p>
      <h2 id="certifications-heading" class="mt-2 text-3xl font-bold tracking-tight text-[#15152a] sm:text-4xl" data-i18n="certs.title">
        {t.certs.title}
      </h2>
      <p class="mt-4 text-base text-slate-500 sm:text-lg" data-i18n="certs.subtitle">
        {t.certs.subtitle}
      </p>
    </div>

    <div class="mt-12">
      <h3 class="text-lg font-semibold text-[#15152a]" data-i18n="certs.stackTitle">{t.certs.stackTitle}</h3>
      <div class="mt-6 grid gap-5 lg:grid-cols-3">
        {
          t.certs.categories.map((cat, i) => (
            <div class="glass spatial-card rounded-3xl p-6">
              <h4 class="text-sm font-bold uppercase tracking-wider text-indigo-500" data-i18n={`certs.categories.${i}.title`}>
                {cat.title}
              </h4>
              <ul class="mt-4 flex flex-wrap gap-2" role="list">
                {cat.skills.map((skill, j) => (
                  <li
                    class="rounded-xl border border-white/70 bg-white/60 px-3 py-1.5 text-xs font-medium text-slate-600"
                    data-i18n={`certs.categories.${i}.skills.${j}`}
                  >
                    {skill}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
