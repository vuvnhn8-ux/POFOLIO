---
import { profile, ui, langs, langLabels } from '../i18n/ui';

const t = ui.en;
const links = [
  { href: '#about', key: 'nav.about', label: t.nav.about },
  { href: '#systems', key: 'nav.systems', label: t.nav.systems },
  { href: '#case-studies', key: 'nav.caseStudies', label: t.nav.caseStudies },
  { href: '#beyond', key: 'nav.beyond', label: t.nav.beyond },
  { href: '#certifications', key: 'nav.certifications', label: t.nav.certifications },
  { href: '#contact', key: 'nav.contact', label: t.nav.contact },
] as const;
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-slate-800/80 bg-slate-950/80 backdrop-blur-xl">
  <nav
    class="mx-auto flex max-w-6xl items-center justify-between gap-3 px-4 py-3 sm:px-6 lg:px-8"
    aria-label="Primary"
  >
    <a
      href="#top"
      class="group flex min-w-0 items-center gap-2.5 font-semibold tracking-tight text-slate-100 transition hover:text-emerald-400"
    >
      <span
        class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-gradient-to-br from-emerald-400 to-lime-400 text-xs font-bold text-slate-950 shadow-lg shadow-emerald-500/30"
        aria-hidden="true"
      >
        {profile.brandInitials}
      </span>
      <span class="hidden truncate sm:inline">{profile.brandName}</span>
    </a>

    <ul class="hidden items-center gap-0.5 lg:flex">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="rounded-lg px-2.5 py-2 text-sm font-medium text-slate-400 transition hover:bg-slate-800/60 hover:text-slate-100"
              data-i18n={link.key}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-1.5 sm:gap-2">
      <!-- Language switcher -->
      <div
        class="flex items-center rounded-lg border border-slate-700 bg-slate-900/80 p-0.5"
        role="group"
        aria-label="Language"
      >
        {
          langs.map((lang) => (
            <button
              type="button"
              class="lang-btn rounded-md px-2 py-1 text-[11px] font-bold tracking-wide text-slate-400 transition hover:text-white data-[active=true]:bg-emerald-600 data-[active=true]:text-white"
              data-lang-set={lang}
              data-active={lang === 'en' ? 'true' : 'false'}
              aria-pressed={lang === 'en' ? 'true' : 'false'}
            >
              {langLabels[lang]}
            </button>
          ))
        }
      </div>

      <a
        href={profile.cvPath}
        download
        class="hidden items-center gap-1.5 rounded-lg border border-slate-700 bg-slate-900/80 px-3 py-2 text-sm font-medium text-slate-200 transition hover:border-emerald-500/50 hover:bg-slate-800 hover:text-white md:inline-flex"
        data-i18n="nav.downloadCv"
      >
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v12m0 0l-4-4m4 4l4-4M4 20h16" />
        </svg>
        {t.nav.downloadCv}
      </a>
      <a
        href="#contact"
        class="inline-flex items-center rounded-lg bg-gradient-to-r from-emerald-500 to-lime-400 px-3.5 py-2 text-sm font-bold text-slate-950 shadow-lg shadow-emerald-500/30 transition hover:from-emerald-400 hover:to-lime-300"
        data-i18n="nav.contact"
      >
        {t.nav.contact}
      </a>

      <button
        type="button"
        id="menu-toggle"
        class="inline-flex items-center justify-center rounded-lg border border-slate-700 p-2 text-slate-300 lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label={t.nav.openMenu}
        data-i18n-aria="nav.openMenu"
      >
        <svg class="h-5 w-5" id="menu-icon-open" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg class="hidden h-5 w-5" id="menu-icon-close" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </nav>

  <div id="mobile-menu" class="hidden border-t border-slate-800 bg-slate-950 lg:hidden" hidden>
    <ul class="mx-auto flex max-w-6xl flex-col gap-1 px-4 py-3 sm:px-6">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="mobile-link block rounded-lg px-3 py-2.5 text-sm font-medium text-slate-300 transition hover:bg-slate-800 hover:text-white"
              data-i18n={link.key}
            >
              {link.label}
            </a>
          </li>
        ))
      }
      <li>
        <a
          href={profile.cvPath}
          download
          class="mobile-link mt-1 flex items-center gap-2 rounded-lg border border-slate-700 px-3 py-2.5 text-sm font-medium text-slate-200"
          data-i18n="nav.downloadCv"
        >
          {t.nav.downloadCv}
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  function setOpen(open: boolean) {
    if (!menu || !toggle || !iconOpen || !iconClose) return;
    menu.hidden = !open;
    menu.classList.toggle('hidden', !open);
    toggle.setAttribute('aria-expanded', String(open));
    iconOpen.classList.toggle('hidden', open);
    iconClose.classList.toggle('hidden', !open);
  }

  toggle?.addEventListener('click', () => {
    const isOpen = toggle.getAttribute('aria-expanded') === 'true';
    setOpen(!isOpen);
  });

  document.querySelectorAll('.mobile-link').forEach((link) => {
    link.addEventListener('click', () => setOpen(false));
  });
</script>
