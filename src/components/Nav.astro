---
import { profile, ui, langs, langLabels } from '../i18n/ui';

const t = ui.en;
const links = [
  { href: '#about', key: 'nav.about', label: t.nav.about },
  { href: '#systems', key: 'nav.systems', label: t.nav.systems },
  { href: '#case-studies', key: 'nav.caseStudies', label: t.nav.caseStudies },
  { href: '#vibe', key: 'nav.vibe', label: t.nav.vibe },
  { href: '#beyond', key: 'nav.beyond', label: t.nav.beyond },
  { href: '#certifications', key: 'nav.certifications', label: t.nav.certifications },
  { href: '#contact', key: 'nav.contact', label: t.nav.contact },
] as const;
---

<header class="fixed inset-x-0 top-0 z-50 px-4 pt-4 sm:px-6">
  <nav
    class="glass mx-auto flex max-w-5xl items-center justify-between gap-3 rounded-2xl px-4 py-2.5"
    aria-label="Primary"
  >
    <a
      href="#top"
      class="spatial-btn flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-[#1a1a2e] text-xs font-bold text-white shadow-lg shadow-indigo-950/20"
      aria-label="Home"
    >
      {profile.brandInitials}
    </a>

    <ul class="hidden items-center gap-0.5 lg:flex">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="spatial-btn rounded-xl px-3 py-2 text-sm font-medium text-slate-600 hover:bg-white/70 hover:text-slate-900"
              data-i18n={link.key}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-2">
      <div
        class="glass-subtle flex items-center rounded-xl p-0.5"
        role="group"
        aria-label="Language"
      >
        {
          langs.map((lang) => (
            <button
              type="button"
              class="lang-btn rounded-lg px-2 py-1 text-[11px] font-bold tracking-wide text-slate-500 transition hover:text-slate-900 data-[active=true]:bg-white data-[active=true]:text-slate-900 data-[active=true]:shadow-sm"
              data-lang-set={lang}
              data-active={lang === 'en' ? 'true' : 'false'}
              aria-pressed={lang === 'en' ? 'true' : 'false'}
            >
              {langLabels[lang]}
            </button>
          ))
        }
      </div>

      <a
        href={profile.cvPath}
        target="_blank"
        rel="noopener noreferrer"
        class="spatial-btn hidden items-center gap-1.5 rounded-xl border border-white/60 bg-white/50 px-3 py-2 text-sm font-medium text-slate-700 hover:bg-white md:inline-flex"
        data-i18n="nav.downloadCv"
      >
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v12m0 0l-4-4m4 4l4-4M4 20h16" />
        </svg>
        {t.nav.downloadCv}
      </a>
      <a
        href={profile.githubUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="spatial-btn inline-flex h-9 w-9 items-center justify-center rounded-xl border border-white/60 bg-white/50 text-slate-600 hover:bg-white hover:text-slate-900"
        aria-label="GitHub"
        title="GitHub"
      >
        <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
        </svg>
      </a>
      <a
        href="#contact"
        class="spatial-btn inline-flex items-center rounded-xl bg-[#1a1a2e] px-3.5 py-2 text-sm font-semibold text-white shadow-lg shadow-indigo-950/25 hover:bg-[#2a2a45]"
        data-i18n="nav.contact"
      >
        {t.nav.contact}
      </a>

      <button
        type="button"
        id="menu-toggle"
        class="spatial-btn inline-flex items-center justify-center rounded-xl border border-white/60 bg-white/50 p-2 text-slate-600 lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label={t.nav.openMenu}
        data-i18n-aria="nav.openMenu"
      >
        <svg class="h-5 w-5" id="menu-icon-open" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg class="hidden h-5 w-5" id="menu-icon-close" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </nav>

  <div id="mobile-menu" class="glass mx-auto mt-2 hidden max-w-5xl rounded-2xl lg:hidden" hidden>
    <ul class="flex flex-col gap-1 p-3">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="mobile-link block rounded-xl px-3 py-2.5 text-sm font-medium text-slate-600 hover:bg-white/70 hover:text-slate-900"
              data-i18n={link.key}
            >
              {link.label}
            </a>
          </li>
        ))
      }
      <li>
        <a
          href={profile.cvPath}
          target="_blank"
          rel="noopener noreferrer"
          class="mobile-link mt-1 flex items-center gap-2 rounded-xl border border-white/60 bg-white/50 px-3 py-2.5 text-sm font-medium text-slate-700"
          data-i18n="nav.downloadCv"
        >
          {t.nav.downloadCv}
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  function setOpen(open: boolean) {
    if (!menu || !toggle || !iconOpen || !iconClose) return;
    menu.hidden = !open;
    menu.classList.toggle('hidden', !open);
    toggle.setAttribute('aria-expanded', String(open));
    iconOpen.classList.toggle('hidden', open);
    iconClose.classList.toggle('hidden', !open);
  }

  toggle?.addEventListener('click', () => {
    const isOpen = toggle.getAttribute('aria-expanded') === 'true';
    setOpen(!isOpen);
  });

  document.querySelectorAll('.mobile-link').forEach((link) => {
    link.addEventListener('click', () => setOpen(false));
  });
</script>
