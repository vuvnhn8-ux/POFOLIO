---
import { ui } from '../i18n/ui';

const t = ui.en;
---

<section
  id="case-studies"
  class="border-t border-slate-800/60 bg-slate-950 py-20 sm:py-24"
  aria-labelledby="case-studies-heading"
>
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl">
      <p class="text-sm font-semibold uppercase tracking-widest text-emerald-400" data-i18n="cases.kicker">{t.cases.kicker}</p>
      <h2 id="case-studies-heading" class="mt-2 text-3xl font-bold tracking-tight text-white sm:text-4xl" data-i18n="cases.title">
        {t.cases.title}
      </h2>
      <p class="mt-4 text-base text-slate-400 sm:text-lg" data-i18n="cases.subtitle">
        {t.cases.subtitle}
      </p>
    </div>

    <div class="mt-12 grid gap-8">
      {
        t.cases.items.map((cs, index) => (
          <article
            class="group relative overflow-hidden rounded-2xl border border-slate-800 bg-slate-900/40 transition hover:border-slate-700 hover:bg-slate-900/70"
            aria-labelledby={cs.id}
          >
            <div class="absolute inset-y-0 left-0 w-1 bg-gradient-to-b from-emerald-400 to-lime-400 opacity-90" aria-hidden="true" />

            <div class="p-6 sm:p-8 lg:p-10">
              <div class="mb-6 overflow-hidden rounded-xl border border-slate-800 bg-slate-950">
                <img
                  src={cs.image}
                  alt=""
                  width="640"
                  height="360"
                  loading="lazy"
                  decoding="async"
                  class="h-auto w-full object-cover"
                />
              </div>
              <div class="flex flex-wrap items-start justify-between gap-4">
                <div>
                  <p class="text-xs font-medium uppercase tracking-wider text-slate-500">
                    0{index + 1} · <span data-i18n={`cases.items.${index}.industry`}>{cs.industry}</span>
                  </p>
                  <h3 id={cs.id} class="mt-1 text-xl font-bold text-white sm:text-2xl" data-i18n={`cases.items.${index}.title`}>
                    {cs.title}
                  </h3>
                </div>
                <ul class="flex flex-wrap gap-2" aria-label="Technologies">
                  {cs.tags.map((tag) => (
                    <li class="rounded-md border border-slate-700/80 bg-slate-950/60 px-2.5 py-1 font-mono text-[11px] text-emerald-300">
                      {tag}
                    </li>
                  ))}
                </ul>
              </div>

              <div class="mt-8 grid gap-6 lg:grid-cols-3">
                <div class="rounded-xl border border-slate-800/80 bg-slate-950/50 p-5">
                  <h4 class="text-xs font-bold uppercase tracking-widest text-rose-400" data-i18n="cases.problem">{t.cases.problem}</h4>
                  <p class="mt-3 text-sm leading-relaxed text-slate-400" data-i18n={`cases.items.${index}.problem`}>{cs.problem}</p>
                </div>
                <div class="rounded-xl border border-slate-800/80 bg-slate-950/50 p-5">
                  <h4 class="text-xs font-bold uppercase tracking-widest text-emerald-400" data-i18n="cases.solution">{t.cases.solution}</h4>
                  <p class="mt-3 text-sm leading-relaxed text-slate-400" data-i18n={`cases.items.${index}.solution`}>{cs.solution}</p>
                </div>
                <div class="rounded-xl border border-emerald-500/20 bg-emerald-500/5 p-5">
                  <h4 class="text-xs font-bold uppercase tracking-widest text-emerald-400" data-i18n="cases.impact">{t.cases.impact}</h4>
                  <dl class="mt-3 grid grid-cols-3 gap-2">
                    {cs.impact.map((item, j) => (
                      <div>
                        <dt class="sr-only" data-i18n={`cases.items.${index}.impact.${j}.label`}>{item.label}</dt>
                        <dd class="text-lg font-bold text-emerald-300 sm:text-xl" data-i18n={`cases.items.${index}.impact.${j}.metric`}>{item.metric}</dd>
                        <dd class="mt-0.5 text-[11px] leading-snug text-slate-500" data-i18n={`cases.items.${index}.impact.${j}.label`}>{item.label}</dd>
                      </div>
                    ))}
                  </dl>
                </div>
              </div>

              <div class="mt-6 overflow-hidden rounded-xl border border-dashed border-slate-700 bg-slate-950/80">
                <div class="flex items-center justify-between border-b border-slate-800 px-4 py-2">
                  <span class="font-mono text-[11px] uppercase tracking-wider text-slate-500" data-i18n="cases.archLabel">
                    {t.cases.archLabel}
                  </span>
                  <span class="rounded bg-slate-800 px-2 py-0.5 font-mono text-[10px] text-slate-400" data-i18n="cases.diagram">{t.cases.diagram}</span>
                </div>
                <pre class="overflow-x-auto px-4 py-5 font-mono text-xs leading-relaxed text-emerald-400/90 sm:text-sm" data-i18n={`cases.items.${index}.architecture`}>{cs.architecture}</pre>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
