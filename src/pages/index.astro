---
import BaseLayout from '../layouts/BaseLayout.astro';
import SpatialBackground from '../components/SpatialBackground.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Systems from '../components/Systems.astro';
import CaseStudies from '../components/CaseStudies.astro';
import VibeCode from '../components/VibeCode.astro';
import Beyond from '../components/Beyond.astro';
import Certifications from '../components/Certifications.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout>
  <SpatialBackground />
  <Nav />
  <main id="main">
    <Hero />
    <About />
    <Systems />
    <CaseStudies />
    <VibeCode />
    <Beyond />
    <Certifications />
    <Contact />
  </main>
  <Footer />
  <script>
    import '../scripts/i18n.ts';
    import '../scripts/spatial.ts';
    import '../scripts/analytics.ts';
  </script>
</BaseLayout>
